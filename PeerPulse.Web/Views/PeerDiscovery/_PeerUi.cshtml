@* Shared by AddPeer, Manage and Groups. IDs match peer-discovery.js. *@
<dialog id="pp-group-dialog" class="rounded-2xl border border-gray-200 border-t-4 border-t-[#7c3aed] bg-white p-6 shadow-2xl dark:border-gray-700 dark:border-t-[#7c3aed] dark:bg-gray-800">
    <div class="flex items-center justify-between border-b border-gray-100 pb-3.5 dark:border-gray-700">
        <h3 id="pp-group-title" class="text-base font-bold text-gray-900 dark:text-white">Create New Peer Group</h3>
        <button type="button" data-close="pp-group-dialog" aria-label="Close group form" class="text-gray-400 hover:text-gray-600">×</button>
    </div>
    <form id="pp-group-form" class="mt-4 space-y-4 text-xs">
        <div>
            <label for="pp-group-name" class="block font-medium text-gray-700 dark:text-gray-300">Peer Group Name <span class="text-red-500">*</span></label>
            <input id="pp-group-name" type="text" required maxlength="200" placeholder="e.g. Enterprise SaaS &amp; Cloud"
                   class="mt-1 w-full rounded-lg border border-gray-300 bg-transparent px-3.5 py-2.5 text-xs text-gray-800 dark:border-gray-700 dark:text-white outline-none focus:border-brand-primary-blue focus:ring-2 focus:ring-brand-primary-blue/20" />
        </div>
        <div>
            <label for="pp-group-vertical" class="block font-medium text-gray-700 dark:text-gray-300">Business Vertical / Product Line Name</label>
            <input id="pp-group-vertical" type="text" maxlength="200" placeholder="e.g. Financial Services, Software Division"
                   class="mt-1 w-full rounded-lg border border-gray-300 bg-transparent px-3.5 py-2.5 text-xs text-gray-800 dark:border-gray-700 dark:text-white outline-none focus:border-brand-primary-blue focus:ring-2 focus:ring-brand-primary-blue/20" />
        </div>
        <div>
            <label for="pp-group-description" class="block font-medium text-gray-700 dark:text-gray-300">Cohort Description &amp; Strategic Focus</label>
            <textarea id="pp-group-description" rows="3" maxlength="1000" placeholder="Describe the peers and comparative metrics tracked…"
                      class="mt-1 w-full rounded-lg border border-gray-300 bg-transparent px-3.5 py-2.5 text-xs text-gray-800 dark:border-gray-700 dark:text-white outline-none focus:border-brand-primary-blue focus:ring-2 focus:ring-brand-primary-blue/20"></textarea>
        </div>
        <div class="pt-2 flex justify-end gap-2">
            <button type="button" data-close="pp-group-dialog" class="rounded-lg border px-4 py-2 text-xs font-medium text-gray-600 dark:text-gray-300">Cancel</button>
            <button type="submit" class="rounded-lg bg-brand-primary-blue px-4 py-2 text-xs font-semibold text-white hover:bg-brand-primary-blue/90">Save Group</button>
        </div>
    </form>
</dialog>

<dialog id="pp-select-dialog" class="rounded-2xl border border-gray-200 border-t-4 border-t-[#114fa2] bg-white p-6 shadow-2xl dark:border-gray-700 dark:border-t-[#114fa2] dark:bg-gray-800">
    <div class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-gray-700">
        <h3 id="pp-select-title" class="text-base font-bold text-gray-900 dark:text-white">Edit Peer Information</h3>
        <button type="button" data-close="pp-select-dialog" aria-label="Close peer form" class="text-gray-400 hover:text-gray-600">×</button>
    </div>
    <p id="pp-select-business" class="mt-3 text-sm font-semibold text-gray-800 dark:text-gray-200"></p>
    <form id="pp-selection-form" class="mt-4 space-y-4">
        <div>
            <div class="flex items-center justify-between gap-2">
                <h4 class="text-xs font-semibold text-gray-700 dark:text-gray-300">Assign Peer Groups <span class="text-red-500">*</span></h4>
                <button id="pp-create-from-selection" type="button" class="text-xs font-semibold text-brand-primary-blue hover:underline dark:text-blue-400">+ Create New Group</button>
            </div>
            <div id="pp-group-options" class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2"></div>
        </div>
        <div>
            <label for="pp-peer-notes" class="block text-xs font-medium text-gray-700 dark:text-gray-300">User Notes &amp; Context</label>
            <textarea id="pp-peer-notes" rows="3" maxlength="1000"
                      class="mt-1 w-full rounded-lg border border-gray-300 bg-transparent px-3.5 py-2.5 text-xs text-gray-800 dark:border-gray-700 dark:text-white outline-none focus:border-brand-primary-blue focus:ring-2 focus:ring-brand-primary-blue/20"></textarea>
        </div>
        <div class="pt-2 flex justify-end gap-2">
            <button type="button" data-close="pp-select-dialog" class="rounded-lg border px-4 py-2 text-xs font-medium text-gray-600 dark:text-gray-300">Cancel</button>
            <button type="submit" class="rounded-lg bg-brand-primary-blue px-4 py-2 text-xs font-semibold text-white hover:bg-brand-primary-blue/90">Save Changes</button>
        </div>
    </form>
</dialog>

<dialog id="pp-confirm-dialog" class="rounded-2xl border border-gray-200 border-t-4 border-t-[#ee312b] bg-white p-6 shadow-2xl dark:border-gray-700 dark:bg-gray-800">
    <h3 class="text-base font-bold text-gray-900 dark:text-white">Confirm action</h3>
    <p id="pp-confirm-text" class="mt-3 text-sm text-gray-600 dark:text-gray-300"></p>
    <div class="mt-5 flex justify-end gap-2">
        <button type="button" data-close="pp-confirm-dialog" class="rounded-lg border px-4 py-2 text-xs font-medium text-gray-600 dark:text-gray-300">Cancel</button>
        <button id="pp-confirm-action" type="button" class="rounded-lg bg-brand-primary-blue px-4 py-2 text-xs font-semibold text-white">Confirm</button>
    </div>
</dialog>

<dialog id="pp-detail-dialog" class="rounded-2xl border border-gray-200 border-t-4 border-t-[#114fa2] bg-white p-6 shadow-2xl dark:border-gray-700 dark:bg-gray-800">
    <div class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-gray-700">
        <h3 class="text-base font-bold text-gray-900 dark:text-white">Peer Details</h3>
        <button type="button" data-close="pp-detail-dialog" aria-label="Close peer details" class="text-gray-400 hover:text-gray-600">×</button>
    </div>
    <div id="pp-detail-content" class="mt-4"></div>
    <div class="mt-5 flex justify-end">
        <button type="button" data-close="pp-detail-dialog" class="rounded-lg border px-4 py-2 text-xs font-medium text-gray-600 dark:text-gray-300">Close</button>
    </div>
</dialog>
