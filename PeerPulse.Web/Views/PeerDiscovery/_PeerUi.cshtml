@{
    var input = "w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder-gray-400 outline-none transition focus:border-[#114fa2] focus:ring-2 focus:ring-[#114fa2]/20 dark:border-gray-700 dark:text-white dark:placeholder-gray-500 dark:focus:border-blue-400";
    var label = "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300";
    var dialog = "m-auto w-full max-w-md rounded-2xl border border-gray-200 border-t-4 border-t-[#114fa2] bg-white p-0 text-gray-800 shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm dark:border-gray-700 dark:border-t-[#114fa2] dark:bg-gray-800 dark:text-gray-100";
    var close = "text-2xl leading-none text-gray-400 hover:text-gray-600 dark:hover:text-gray-200";
    var btnPrimary = "inline-flex items-center justify-center gap-2 rounded-lg bg-[#114fa2] px-4 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-[#114fa2]/90 disabled:cursor-not-allowed disabled:opacity-50";
    var btnOutline = "inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600";
    var msg = "pp-message text-xs text-red-600 empty:hidden dark:text-red-400";
}

@* Remove this link after peer-discovery.js is converted to Tailwind *@
<link rel="stylesheet" href="~/css/peer-discovery.css" asp-append-version="true" />

<!-- Create group -->
<dialog id="pp-group-dialog" class="@dialog" aria-labelledby="pp-group-title">
    <form id="pp-group-form" class="p-6">
        <div class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-gray-700">
            <h2 id="pp-group-title" class="text-base font-bold text-gray-900 dark:text-white">Create New Peer Group</h2>
            <button type="button" data-close="pp-group-dialog" class="@close" aria-label="Close">×</button>
        </div>

        <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
            Create a group, then select it before adding your peer.
        </p>

        <div class="mt-4 space-y-3">
            <div>
                <label for="pp-group-name" class="@label">Peer Group Name <span class="text-red-500">*</span></label>
                <input id="pp-group-name" class="@input" required maxlength="100" />
            </div>
            <div>
                <label for="pp-group-vertical" class="@label">Business Vertical / Product Line Name</label>
                <input id="pp-group-vertical" class="@input" maxlength="150" />
            </div>
            <div>
                <label for="pp-group-description" class="@label">Cohort Description &amp; Strategic Focus</label>
                <textarea id="pp-group-description" class="@input" rows="3" maxlength="1000"></textarea>
            </div>
        </div>

        <p class="@msg mt-3" data-dialog-message role="alert"></p>

        <div class="mt-4 flex justify-end gap-2">
            <button type="button" data-close="pp-group-dialog" class="@btnOutline">Cancel</button>
            <button type="submit" class="@btnPrimary">Save Group</button>
        </div>
    </form>
</dialog>

<!-- Select groups -->
<dialog id="pp-select-dialog" class="@dialog" aria-labelledby="pp-select-title">
    <form id="pp-selection-form" class="p-6">
        <div class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-gray-700">
            <h2 id="pp-select-title" class="text-base font-bold text-gray-900 dark:text-white">Select a Peer Group</h2>
            <button type="button" data-close="pp-select-dialog" class="@close" aria-label="Close">×</button>
        </div>

        <p id="pp-select-business" class="mt-3 text-sm font-semibold text-gray-800 dark:text-gray-100"></p>
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Select at least one group to continue.</p>

        <div id="pp-group-options" class="pp-group-options mt-3 grid max-h-60 grid-cols-1 gap-2 overflow-y-auto sm:grid-cols-2"></div>

        <button type="button" id="pp-create-from-selection"
                class="pp-text-button mt-3 inline-flex items-center gap-1 text-xs font-semibold text-[#114fa2] hover:underline dark:text-blue-400">
            + Create New Group
        </button>

        <div class="mt-4">
            <label for="pp-peer-notes" class="@label">User Notes</label>
            <textarea id="pp-peer-notes" class="@input" rows="3" maxlength="1000"></textarea>
        </div>

        <p class="@msg mt-3" data-dialog-message role="alert"></p>

        <div class="mt-4 flex justify-end gap-2">
            <button type="button" data-close="pp-select-dialog" class="@btnOutline">Cancel</button>
            <button type="submit" class="@btnPrimary">Save Peer</button>
        </div>
    </form>
</dialog>

<!-- Confirm -->
<dialog id="pp-confirm-dialog" class="@dialog" aria-labelledby="pp-confirm-title">
    <div class="p-6">
        <h2 id="pp-confirm-title" class="text-base font-bold text-gray-900 dark:text-white">Confirm action</h2>
        <p id="pp-confirm-text" class="mt-3 text-sm text-gray-600 dark:text-gray-300"></p>
        <p class="@msg mt-3" data-dialog-message role="alert"></p>

        <div class="mt-5 flex justify-end gap-2">
            <button type="button" data-close="pp-confirm-dialog" class="@btnOutline">Cancel</button>
            <button id="pp-confirm-action" type="button" class="@btnPrimary">Confirm</button>
        </div>
    </div>
</dialog>