@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Manage Peers";
    ViewData["DashboardPage"] = "manage-peers";

    var input = "w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder-gray-400 outline-none transition focus:border-[#114fa2] focus:ring-2 focus:ring-[#114fa2]/20 dark:border-gray-700 dark:text-white dark:placeholder-gray-500 dark:focus:border-blue-400";
    var btnPrimary = "inline-flex items-center justify-center gap-2 rounded-lg bg-[#114fa2] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#114fa2]/90";
    var btnOutline = "inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700";
    var card = "rounded-2xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-800/90";
    var th = "px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400";
}

<div class="peer-ui"
     data-peer-page="manage"
     data-base="@Url.Action("Workspace", "PeerDiscovery")"
     data-update-peer="@Url.Action("UpdatePeer", "PeerDiscovery")"
     data-deactivate-peer="@Url.Action("DeactivatePeer", "PeerDiscovery")"
     data-reactivate-peer="@Url.Action("ReactivatePeer", "PeerDiscovery")"
     data-create-group="@Url.Action("CreateGroup", "PeerDiscovery")">

    <div class="mb-6 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <div class="mb-1 flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
                <a asp-controller="Dashboard" asp-action="Index" class="hover:text-[#114fa2] dark:hover:text-blue-300">Dashboard</a>
                <span>/</span>
                <span class="text-gray-700 dark:text-gray-300">Peer Discovery</span>
                <span>/</span>
                <span class="font-medium text-[#114fa2] dark:text-blue-400">Manage Peers</span>
            </div>
            <h2 class="flex items-center gap-2.5 text-3xl font-bold text-gray-900 dark:text-white">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[#114fa2]/10 text-[#114fa2] dark:bg-[#114fa2]/20 dark:text-blue-400">
                    <i class="bi bi-people text-lg"></i>
                </span>
                Manage Peers
            </h2>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <a asp-action="AddPeer" class="@btnPrimary">+ Add Your Peer</a>
            <a asp-action="Groups" class="@btnOutline">Manage Peer Groups</a>
            <button id="pp-export" type="button" class="@btnOutline">Export CSV</button>
        </div>
    </div>

    <div class="mb-6 rounded-xl border border-gray-200 border-t-2 border-t-[#114fa2] bg-gradient-to-r from-blue-50/70 via-white to-emerald-50/50 p-4 sm:p-5 dark:border-gray-800 dark:border-t-[#114fa2] dark:from-gray-800/80 dark:via-gray-800/50 dark:to-gray-800/80">
        <div class="flex items-start gap-3.5">
            <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#114fa2] text-white shadow-sm">
                <i class="bi bi-people"></i>
            </div>
            <div class="grow">
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white">Your Peer Portfolio</h4>
                <p class="mt-1 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                    Review companies and LLPs, update groups and notes, or mark peers inactive while preserving their information.
                </p>
            </div>
        </div>
    </div>

@*     <p id="pp-message" class="pp-message mb-4 text-sm empty:hidden" role="status" aria-live="polite"></p>
 *@
    <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="@card border-t-2 border-t-[#114fa2]">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Active Peers</span>
            <strong id="pp-total" class="mt-1 block text-2xl font-bold text-gray-900 dark:text-white">—</strong>
        </div>
        <div class="@card border-t-2 border-t-[#0f9b48]">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Balance Peers</span>
            <strong id="pp-balance" class="mt-1 block text-2xl font-bold text-gray-900 dark:text-white">—</strong>
            <small id="pp-cap" class="text-xs text-gray-500 dark:text-gray-400"></small>
        </div>
        <div class="@card border-t-2 border-t-[#7c3aed]">
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Total Groups</span>
            <strong id="pp-group-total" class="mt-1 block text-2xl font-bold text-gray-900 dark:text-white">—</strong>
        </div>
    </div>

    <div class="mb-6 grid grid-cols-1 gap-3 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm md:grid-cols-3 dark:border-gray-800 dark:bg-gray-800/90">
        <input id="pp-filter" class="@input"
               placeholder="Search by name, PAN, CIN, LLPIN, or notes"
               aria-label="Filter peers" />

        <select id="pp-group-filter" class="@input" aria-label="Filter peer group">
            <option value="">All groups</option>
        </select>

        <select id="pp-status-filter" class="@input" aria-label="Filter activity status">
            <option value="active">Active peers</option>
            <option value="inactive">Inactive peers</option>
            <option value="all">All peers</option>
        </select>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-800/90">
        <table class="w-full min-w-[900px] text-left">
            <thead class="border-b border-gray-100 bg-gray-50/70 dark:border-gray-700 dark:bg-gray-900/40">
                <tr>
                    <th class="@th">Peer Company / LLP</th>
                    <th class="@th">Identifier</th>
                    <th class="@th">Groups</th>
                    <th class="@th">Activity</th>
                    <th class="@th">Notes</th>
                    <th class="@th">Actions</th>
                </tr>
            </thead>
            <tbody id="pp-peer-rows"
                   class="divide-y divide-gray-100 text-gray-700 dark:divide-gray-700 dark:text-gray-200 [&_td]:px-4 [&_td]:py-3 [&_td]:align-top [&_td]:text-sm"></tbody>
        </table>
        <p id="pp-peer-empty" class="pp-empty p-6 text-center text-sm text-gray-500 dark:text-gray-400">Loading peers…</p>
    </div>

    <div class="pp-token">@Html.AntiForgeryToken()</div>
    @await Html.PartialAsync("_PeerUi")
</div>

@section Scripts {
    <script src="~/js/peer-discovery/peer-discovery.js" asp-append-version="true"></script>
}