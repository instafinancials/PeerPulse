@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Manage Peers";
    ViewData["DashboardPage"] = "manage-peers";
}

<div class="peer-ui" data-peer-page="manage"
     data-base='@Url.Action("Workspace", "PeerDiscovery")'
     data-search='@Url.Action("Search", "PeerDiscovery")'
     data-add='@Url.Action("AddPeer", "PeerDiscovery")'
     data-update-peer='@Url.Action("UpdatePeer", "PeerDiscovery")'
     data-deactivate-peer='@Url.Action("DeactivatePeer", "PeerDiscovery")'
     data-reactivate-peer='@Url.Action("ReactivatePeer", "PeerDiscovery")'
     data-create-group='@Url.Action("CreateGroup", "PeerDiscovery")'
     data-update-group='@Url.Action("UpdateGroup", "PeerDiscovery")'
     data-delete-group='@Url.Action("DeleteGroup", "PeerDiscovery")'
     data-manage='@Url.Action("Manage", "PeerDiscovery")'>
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

        <div>

            <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-1">
                <span class="text-gray-700 dark:text-gray-300">Peer Discovery</span>
                <span>/</span>
                <span class="font-medium text-brand-primary-blue dark:text-brand-400">Manage Peers</span>

            </div>

            <h2 class="text-title-sm font-bold text-gray-900 dark:text-white flex items-center gap-2.5">

                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-primary-blue/10 text-brand-primary-blue dark:bg-brand-primary-blue/20 dark:text-blue-400">

                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>

                        <circle cx="9" cy="7" r="4"></circle>

                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>

                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>

                    </svg>

                </span>

                Manage Your Peers

            </h2>

        </div>



        <div class="flex flex-wrap items-center gap-2.5">

            <button type="button" class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-xs font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700" id="pp-export">

                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>

                    <polyline points="7 10 12 15 17 10"></polyline>

                    <line x1="12" y1="15" x2="12" y2="3"></line>

                </svg>

                Export CSV

            </button>

            <a class="inline-flex items-center gap-2 rounded-lg bg-brand-primary-blue px-4 py-2.5 text-xs font-semibold text-white shadow-sm hover:bg-brand-primary-blue/90" asp-controller="PeerDiscovery" asp-action="AddPeer">

                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                    <line x1="12" y1="5" x2="12" y2="19"></line>

                    <line x1="5" y1="12" x2="19" y2="12"></line>

                </svg>

                + Add New Peer

            </a>

        </div>

    </div>



          

    <div class="mb-6 grid grid-cols-2 gap-4 sm:grid-cols-4">

        <div class="rounded-2xl border border-gray-200 border-t-2 border-t-[#114fa2] bg-white p-4 shadow-xs dark:border-gray-800 dark:border-t-[#114fa2] dark:bg-gray-800">

            <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Total Subscribed Peers</span>

            <div class="mt-1 flex items-baseline justify-between">

                <span class="text-2xl font-bold text-gray-900 dark:text-white" id="pp-subscription-limit">—</span>

            </div>

        </div>

        <div class="rounded-2xl border border-gray-200 border-t-2 border-t-[#7c3aed] bg-white p-4 shadow-xs dark:border-gray-800 dark:border-t-[#7c3aed] dark:bg-gray-800">

            <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Active Peers</span>

            <div class="mt-1 flex items-baseline justify-between">

                <span class="text-2xl font-bold text-brand-primary-blue dark:text-blue-400" id="pp-total">—</span>

                <span class="text-xs text-gray-400" data-peer-cap=""></span>

            </div>

        </div>

        <div class="rounded-2xl border border-gray-200 border-t-2 border-t-[#0f9b48] bg-white p-4 shadow-xs dark:border-gray-800 dark:border-t-[#0f9b48] dark:bg-gray-800">

            <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Balance Peers</span>

            <div class="mt-1 flex items-baseline justify-between">

                <span class="text-2xl font-bold text-emerald-600 dark:text-emerald-400" id="pp-balance">—</span>

                <span class="text-xs text-gray-400" data-peer-cap=""></span>

                <div class="mt-1 flex items-baseline justify-between">

                    <a class="rounded-md bg-green-50 px-2 py-0.5 text-xs font-semibold text-green-700 dark:bg-green-900/40 dark:text-green-300" asp-controller="PeerDiscovery" asp-action="AddPeer">
                        +

                        Add Peers

                    </a>

                </div>

            </div>

        </div>

        <div class="rounded-2xl border border-gray-200 border-t-2 border-t-[#ed8231] bg-white p-4 shadow-xs dark:border-gray-800 dark:border-t-[#ed8231] dark:bg-gray-800">

            <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Total Groups</span>

            <div class="mt-1 flex items-baseline justify-between">

                <span class="text-2xl font-bold text-purple-600 dark:text-purple-400" id="pp-group-total">—</span>

            </div>

            <a class="text-xs text-brand-primary-blue hover:underline dark:text-blue-400" asp-controller="PeerDiscovery" asp-action="Groups">View</a>

        </div>

    </div>



          

    <div class="mb-5 rounded-2xl border border-gray-200 border-t-2 border-t-[#114fa2] bg-white p-4 shadow-xs dark:border-gray-800 dark:border-t-[#114fa2] dark:bg-gray-800">

        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">



            <!-- Search Bar -->

            <div class="relative flex-1 max-w-md">

                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">

                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                        <circle cx="11" cy="11" r="8"></circle>

                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>

                    </svg>

                </span>

                <input type="text" placeholder="Search by Peer Name, PAN, GSTIN, CIN, Notes..." class="w-full rounded-lg border border-gray-300 bg-transparent pl-10 pr-4 py-2 text-xs text-gray-800 placeholder-gray-400 shadow-theme-xs outline-none transition focus:border-brand-primary-blue focus:ring-2 focus:ring-brand-primary-blue/20 dark:border-gray-700 dark:text-white" id="pp-filter">

            </div>



            <!-- Filter Controls -->

            <div class="flex flex-wrap items-center gap-2.5">

                <!-- Group Filter -->

                <select id="pp-status-filter" aria-label="Activity status" class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200">
                    <option value="active">Active peers</option>
                    <option value="inactive">Inactive peers</option>
                    <option value="all">All peers</option>
                </select><div class="flex items-center gap-1.5">

                <span class="text-xs text-gray-500 dark:text-gray-400 font-medium">Group:</span>

                <select class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200" id="pp-group-filter">

                    <option value="">All groups</option>
                </select>

            </div>



            <!-- Sort Filter -->

            <div class="flex items-center gap-1.5">

                <span class="text-xs text-gray-500 dark:text-gray-400 font-medium">Sort:</span>

                <select class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-xs text-gray-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200" id="pp-sort">

                    <option value="dateAdded">Date Added</option>

                    <option value="legalName">Peer Name (A-Z)</option>

                    <option value="groupName">Peer Group</option>

                    <option value="state">State</option>

                </select>

                <button type="button" class="rounded-lg border border-gray-300 p-2 text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300" id="pp-sort-direction" aria-label="Reverse sort direction" title="Reverse sort direction">↑</button>

            </div>



            <!-- View Toggle (Table / Grid) -->

            <div class="flex rounded-lg border border-gray-200 p-0.5 bg-gray-100 dark:border-gray-700 dark:bg-gray-900">

                <button type="button" class="rounded-md p-1.5 transition" data-view="table" aria-label="Table view">

                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                        <line x1="8" y1="6" x2="21" y2="6"></line>

                        <line x1="8" y1="12" x2="21" y2="12"></line>

                        <line x1="8" y1="18" x2="21" y2="18"></line>

                        <line x1="3" y1="6" x2="3.01" y2="6"></line>

                        <line x1="3" y1="12" x2="3.01" y2="12"></line>

                        <line x1="3" y1="18" x2="3.01" y2="18"></line>

                    </svg>

                </button>

                <button type="button" class="rounded-md p-1.5 transition" data-view="grid" aria-label="Grid view">

                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                        <rect x="3" y="3" width="7" height="7"></rect>

                        <rect x="14" y="3" width="7" height="7"></rect>

                        <rect x="14" y="14" width="7" height="7"></rect>

                        <rect x="3" y="14" width="7" height="7"></rect>

                    </svg>

                </button>

            </div>



        </div>



    </div>

</div>



          

<p id="pp-selection-count" class="mb-3 text-xs text-gray-500 dark:text-gray-400" role="status">0 selected</p>

<div class="overflow-hidden rounded-2xl border border-gray-200 border-t-2 border-t-[#114fa2] bg-white shadow-xs dark:border-gray-800 dark:border-t-[#114fa2] dark:bg-gray-800" id="pp-table-view">

    <div class="max-w-full overflow-x-auto">

        <table class="w-full table-auto text-left border-collapse">

            <thead>

                <tr class="border-b border-gray-200 bg-gray-50/80 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:border-gray-700 dark:bg-gray-900/50 dark:text-gray-400">

                    <th class="p-4 w-10">

                        <input type="checkbox" class="h-4 w-4 rounded border-gray-300 text-brand-primary-blue focus:ring-brand-primary-blue/20 dark:border-gray-700 dark:bg-gray-800" id="pp-select-all" aria-label="Select visible peers">

                    </th>

                    <th class="py-4 px-4 min-w-[220px]">Peer Company Name</th>

                    <th class="py-4 px-4 min-w-[130px]">PAN</th>

                    <th class="py-4 px-4 min-w-[190px]">CIN / LLPIN</th>

                    <th class="py-4 px-4 min-w-[170px]">Peer Group</th>

                    <th class="py-4 px-4 min-w-[280px]">User Notes</th>

                    <th class="py-4 px-4 min-w-[110px]">Date Added</th>

                    <th class="py-4 px-4 text-right min-w-[120px]">Actions</th>

                </tr>

            </thead>

            <tbody id="pp-peer-rows" class="divide-y divide-gray-100 text-xs dark:divide-gray-700"></tbody>
        </table>

    </div>

    <p id="pp-peer-empty" class="p-6 text-center text-sm text-gray-500 dark:text-gray-400">Loading peers…</p>
</div>



          

<div id="pp-peer-grid" hidden="hidden" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5"></div>

<div hidden>@Html.AntiForgeryToken()</div>
@await Html.PartialAsync("_PeerUi")
</div>

@section Scripts {
    <script src="~/js/peer-discovery/peer-discovery.js" asp-append-version="true"></script>
}
