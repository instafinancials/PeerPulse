@model PeerPulse.Web.Models.AddPeerViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Add Your Peer";
    ViewData["DashboardPage"] = "add-peer";
}

<div class="peer-ui" data-peer-page="add"
     data-base='@Url.Action("Workspace", "PeerDiscovery")'
     data-search='@Url.Action("Search", "PeerDiscovery")'
     data-add='@Url.Action("AddPeer", "PeerDiscovery")'
     data-update-peer='@Url.Action("UpdatePeer", "PeerDiscovery")'
     data-deactivate-peer='@Url.Action("DeactivatePeer", "PeerDiscovery")'
     data-reactivate-peer='@Url.Action("ReactivatePeer", "PeerDiscovery")'
     data-create-group='@Url.Action("CreateGroup", "PeerDiscovery")'
     data-update-group='@Url.Action("UpdateGroup", "PeerDiscovery")'
     data-delete-group='@Url.Action("DeleteGroup", "PeerDiscovery")'
     data-manage='@Url.Action("Manage", "PeerDiscovery")'>
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-1">
                <span class="text-gray-700 dark:text-gray-300">Peer Discovery</span>
                <span>/</span>
                <span class="font-medium text-brand-primary-blue dark:text-brand-400">Add Your Peer</span>
            </div>
            <h2 class="text-title-sm font-bold text-gray-900 dark:text-white flex items-center gap-2.5">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-primary-blue/10 text-brand-primary-blue dark:bg-brand-primary-blue/20 dark:text-blue-400">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="8.5" cy="7" r="4"></circle>
                        <line x1="20" y1="8" x2="20" y2="14"></line>
                        <line x1="23" y1="11" x2="17" y2="11"></line>
                    </svg>
                </span>
                Add Your Peer
            </h2>
        </div>

        <div class="flex items-center gap-3">
            <a class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-center text-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700" asp-controller="PeerDiscovery" asp-action="Manage">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                View Manage Peers (<span data-peer-count="">—</span>)
            </a>
        </div>
    </div>

          

    <div class="mb-6 rounded-xl border border-gray-200 border-t-2 border-t-[#114fa2] bg-gradient-to-r from-blue-50/70 via-white to-emerald-50/50 p-4 sm:p-5 dark:border-gray-800 dark:border-t-[#114fa2] dark:from-gray-800/80 dark:via-gray-800/50 dark:to-gray-800/80">
        <div class="flex items-start gap-3.5">
            <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-primary-blue text-white shadow-sm">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </div>
            <div class="grow">
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white">Peer Onboarding</h4>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                    Enter any official business identifier: <strong>PAN</strong> (10-digits),
                    <strong>CIN</strong> (21-digits), or <strong>LLPIN</strong> (8 characters including hyphen). Our intelligent
                    engine verifies compliance, pulls
                    certified MCA &amp; GST financial profiles, and lets you map the company to your target.
                </p>
            </div>
        </div>
    </div>

          

    <div class="grid grid-cols-12 gap-6">

        <!-- Left Column: Input Form & Verification Card -->
        <div class="col-span-12 xl:col-span-6 space-y-6">

            <!-- STEP 1: Input Identifier Card -->
            <div class="rounded-2xl border border-gray-200 border-t-2 border-t-[#114fa2] bg-white p-5 shadow-sm dark:border-gray-800 dark:border-t-[#114fa2] dark:bg-gray-800/90 sm:p-6">
                <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-5 dark:border-gray-700">
                    <div class="flex items-center gap-2.5">
                        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-primary-blue text-xs font-bold text-white">1</span>
                        <h3 class="text-base font-semibold text-gray-900 dark:text-white">Enter Peer Unique Identifier</h3>
                    </div>
                </div>

                <form class="space-y-4" id="pp-search-form" method="post" asp-action="Search" asp-antiforgery="false">
                    <input type="hidden" name="IdentifierType" value="PAN">
                    <div>
                        <div class="mb-2 flex items-center justify-between gap-2 flex-wrap">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-300">
                                Select your input type
                            </label>
                            <a href="https://www.instafinancials.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs font-medium text-brand-primary-blue hover:text-blue-700 hover:underline dark:text-blue-400 dark:hover:text-blue-300 group">
                                <span>Need help in Finding the Unique ID? Visit InstaFinancials</span>
                                <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                    <polyline points="15 3 21 3 21 9"></polyline>
                                    <line x1="10" y1="14" x2="21" y2="3"></line>
                                </svg>
                            </a>
                        </div>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                            <button type="button" class="flex items-center justify-center rounded-lg border px-2 py-2 text-xs transition border-blue-500 bg-blue-100/90 font-semibold text-blue-950 shadow-xs ring-2 ring-blue-500/20 dark:border-blue-400 dark:bg-blue-900/50 dark:text-blue-100" data-type="PAN" data-class-active="border-blue-500 bg-blue-100/90 font-semibold text-blue-950 shadow-xs ring-2 ring-blue-500/20 dark:border-blue-400 dark:bg-blue-900/50 dark:text-blue-100" data-class-inactive="border-blue-200/80 bg-blue-50/50 text-blue-800 hover:bg-blue-100/60 dark:border-blue-900/40 dark:bg-blue-950/20 dark:text-blue-300" data-base-class="flex items-center justify-center rounded-lg border px-2 py-2 text-xs transition" aria-pressed="true">
                                PAN (10-char)
                            </button>
                            <button type="button" class="flex items-center justify-center rounded-lg border px-2 py-2 text-xs transition border-purple-200/80 bg-purple-50/50 text-purple-800 hover:bg-purple-100/60 dark:border-purple-900/40 dark:bg-purple-950/20 dark:text-purple-300" data-type="CIN" data-class-active="border-purple-500 bg-purple-100/90 font-semibold text-purple-950 shadow-xs ring-2 ring-purple-500/20 dark:border-purple-400 dark:bg-purple-900/50 dark:text-purple-100" data-class-inactive="border-purple-200/80 bg-purple-50/50 text-purple-800 hover:bg-purple-100/60 dark:border-purple-900/40 dark:bg-purple-950/20 dark:text-purple-300" data-base-class="flex items-center justify-center rounded-lg border px-2 py-2 text-xs transition" aria-pressed="false">
                                CIN (21-char)
                            </button>
                            <button type="button" class="flex items-center justify-center rounded-lg border px-2 py-2 text-xs transition border-amber-200/80 bg-amber-50/50 text-amber-800 hover:bg-amber-100/60 dark:border-amber-900/40 dark:bg-amber-950/20 dark:text-amber-300" data-type="LLPIN" data-class-active="border-amber-500 bg-amber-100/90 font-semibold text-amber-950 shadow-xs ring-2 ring-amber-500/20 dark:border-amber-400 dark:bg-amber-900/50 dark:text-amber-100" data-class-inactive="border-amber-200/80 bg-amber-50/50 text-amber-800 hover:bg-amber-100/60 dark:border-amber-900/40 dark:bg-amber-950/20 dark:text-amber-300" data-base-class="flex items-center justify-center rounded-lg border px-2 py-2 text-xs transition" aria-pressed="false">LLPIN (8-char)</button>
                        </div>
                    </div>

                    <!-- Text Input -->
                    <div>
                        <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300">
                            Business Identifier (PAN / CIN / LLPIN) <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="text" placeholder="e.g., AAACI4818J, 29AAACI4818J1ZP, L85110KA1981PLC013115, or AAA-0364" class="w-full uppercase font-mono tracking-wider rounded-lg border border-gray-300 bg-transparent px-4 py-3 text-sm text-gray-800 placeholder-gray-400 shadow-theme-xs outline-none transition focus:border-brand-primary-blue focus:ring-2 focus:ring-brand-primary-blue/20 dark:border-gray-700 dark:text-white dark:placeholder-gray-500 dark:focus:border-blue-400" id="pp-identifier" name="Identifier" maxlength="21" required="required" autocomplete="off" spellcheck="false">
                            <div class="absolute right-3 top-3 flex items-center gap-1.5">
                                <span class="text-xs font-mono font-medium text-gray-400 dark:text-gray-500">
                                    <span id="pp-character-count">0</span> chars
                                </span>
                                <button type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200" id="pp-clear-identifier" hidden>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- Validation Error Message -->
                        <p id="pp-validation" hidden role="alert" class="mt-2 rounded-lg border border-red-200 bg-red-50 p-3 text-xs text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-300"></p>
                    </div>

                    <!-- Quick Sample Chips -->
                    <div>
                        <span class="text-xs text-gray-500 dark:text-gray-400 font-medium">Quick Test Examples:</span>
                        <div class="mt-1.5 flex flex-wrap gap-1.5">
                            <button type="button" class="rounded-md border border-purple-200/80 bg-purple-50/60 px-2 py-1 text-[11px] font-medium text-purple-800 hover:bg-purple-100/70 hover:border-purple-300 dark:border-purple-900/50 dark:bg-purple-950/30 dark:text-purple-300" data-sample="U72300KA2012PTC066088" data-sample-type="CIN">
                                ⚡ Zauba (CIN)
                            </button>
                            <button type="button" class="rounded-md border border-blue-200/80 bg-blue-50/60 px-2 py-1 text-[11px] font-medium text-blue-800 hover:bg-blue-100/70 hover:border-blue-300 dark:border-blue-900/50 dark:bg-blue-950/30 dark:text-blue-300" data-sample="AABCO3409C" data-sample-type="PAN">
                                ⚡ Tofler (PAN)
                            </button>
                            <button type="button" class="rounded-md border border-amber-200/80 bg-amber-50/60 px-2 py-1 text-[11px] font-medium text-amber-800 hover:bg-amber-100/70 hover:border-amber-300 dark:border-amber-900/50 dark:bg-amber-950/30 dark:text-amber-300" data-sample="AAA-0364" data-sample-type="LLPIN">
                                ⚡ PwC (LLPIN)
                            </button>
                         
                        </div>
                    </div>

                    <!-- Submit Search Button -->
                    <div class="pt-2">
                        <button type="submit" class="w-full flex items-center justify-center gap-2 rounded-lg bg-brand-primary-blue px-5 py-3 text-center text-sm font-semibold text-white shadow-sm transition hover:bg-brand-primary-blue/90 disabled:opacity-50 disabled:cursor-not-allowed" id="pp-search-button" disabled>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-icon="">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <span data-label="">Verify &amp; Search Peer Database</span>
                        </button>
                        <div class="mt-3.5 rounded-xl border border-gray-200/90 bg-gray-50/80 p-3.5 dark:border-gray-700/80 dark:bg-gray-800/60">
                            <div class="flex items-center justify-between text-xs mb-1.5">
                                <div class="flex items-center gap-1.5 font-semibold text-gray-700 dark:text-gray-300">
                                    <svg class="h-4 w-4 text-brand-primary-blue dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    <span>Daily Search Limit &amp; Consumption</span>
                                </div>
                                <div class="font-mono text-xs font-semibold text-gray-800 dark:text-gray-200">
                                    <span class="text-brand-primary-blue font-bold dark:text-blue-400" id="pp-used">@(Model.Quota?.Used ?? 0)</span>
                                    <span class="text-gray-400">/</span>
                                    <span id="pp-limit">@(Model.Quota?.DailyLimit ?? 0)</span>
                                    <span class="text-[11px] font-normal text-gray-500 dark:text-gray-400">searches</span>
                                </div>
                            </div>

                            <!-- Progress Bar -->
                            <div class="h-2 w-full overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700">
                                <div class="h-full rounded-full bg-brand-primary-blue transition-all duration-500" id="pp-progress" style="width:0%"></div>
                            </div>

                            <div class="mt-2 flex items-center justify-between text-[11px] text-gray-500 dark:text-gray-400">
                                <span>
                                    <strong class="font-semibold text-emerald-600 dark:text-emerald-400" id="pp-remaining">@(Model.Quota?.Remaining ?? 0)</strong> searches remaining
                                    today
                                </span>
                                <span class="text-[10px] text-gray-400">Daily Quota: @(Model.Quota?.DailyLimit ?? 0)</span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- NOT FOUND IN DB STATE -->
            <!-- Initial Helper / Tips Card -->
            <div class="rounded-2xl border border-gray-200 border-t-2 border-t-[#7c3aed] bg-white p-5 shadow-sm dark:border-gray-800 dark:border-t-[#7c3aed] dark:bg-gray-800/90">
                <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">
                    Supported
                    Identifier Formats
                </h4>
                <div class="space-y-3 text-xs text-gray-600 dark:text-gray-300">
                    <div class="flex items-start gap-2.5">
                        <span class="rounded bg-blue-100 px-1.5 py-0.5 font-mono text-[11px] font-bold text-blue-800 dark:bg-blue-900/60 dark:text-blue-300">PAN</span>
                        <div>
                            <strong class="text-gray-800 dark:text-gray-200">Permanent Account Number (10 Chars):</strong> 5
                            letters, 4 digits, 1 letter. e.g. <code class="font-mono text-gray-700 dark:text-gray-300">AAACI4818J</code>
                        </div>
                    </div>
                 @*    <div class="flex items-start gap-2.5">
                        <span class="rounded bg-emerald-100 px-1.5 py-0.5 font-mono text-[11px] font-bold text-emerald-800 dark:bg-emerald-900/60 dark:text-emerald-300">GSTIN</span>
                        <div>
                            <strong class="text-gray-800 dark:text-gray-200">GST Identification Number (15 Chars):</strong>
                            2-digit state code + PAN + entity digit + Z + checksum. e.g. <code class="font-mono text-gray-700 dark:text-gray-300">29AAACI4818J1ZP</code>
                        </div>
                    </div> *@
                    <div class="flex items-start gap-2.5">
                        <span class="rounded bg-purple-100 px-1.5 py-0.5 font-mono text-[11px] font-bold text-purple-800 dark:bg-purple-900/60 dark:text-purple-300">CIN</span>
                        <div>
                            <strong class="text-gray-800 dark:text-gray-200">
                                Corporate Identification Number (21
                                Chars):
                            </strong> Listing status (L/U) + 5-digit NIC + 2-digit state + 4-digit year + 3-char
                            ownership + 6-digit reg. e.g. <code class="font-mono text-gray-700 dark:text-gray-300">L85110KA1981PLC013115</code>
                        </div>
                    </div>
                    <div class="flex items-start gap-2.5">
                        <span class="rounded bg-amber-100 px-1.5 py-0.5 font-mono text-[11px] font-bold text-amber-800 dark:bg-amber-900/60 dark:text-amber-300">LLPIN</span>
                        <div>
                            <strong class="text-gray-800 dark:text-gray-200">Limited Liability Partnership Identification Number (8 characters including hyphen):</strong> 3-letter prefix + 4 digits. e.g. <code class="font-mono text-gray-700 dark:text-gray-300">AAA-0364</code>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Right Column: Verified Peer Review & Customization Card -->
        <div class="col-span-12 xl:col-span-6">
            <section id="pp-results" aria-live="polite">
                <div class="rounded-2xl border-2 border-dashed border-gray-300 border-t-2 border-t-[#114fa2] bg-gray-50/50 p-8 text-center dark:border-gray-700 dark:border-t-[#114fa2] dark:bg-gray-800/30">
                    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-white text-gray-400 shadow-sm dark:bg-gray-800"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><path d="M8 13h8M8 17h8"></path></svg></div>
                    <h4 class="mt-4 text-sm font-semibold text-gray-700 dark:text-gray-200">Awaiting Business Identifier Input</h4>
                    <p class="mx-auto mt-1 max-w-sm text-xs text-gray-500 dark:text-gray-400">Enter a PAN, CIN or LLPIN on the left and click Verify. Registry details will appear here for review.</p>
                </div>
            </section>
        </div>

    </div>

          

    <div hidden>@Html.AntiForgeryToken()</div>
    @await Html.PartialAsync("_PeerUi")
</div>

@section Scripts {
    <script src="~/js/peer-discovery/peer-discovery.js" asp-append-version="true"></script>
}
