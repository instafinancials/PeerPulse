@model PeerPulse.Web.Models.AddPeerViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Add Your Peer";
    ViewData["DashboardPage"] = "add-peer";
}

<div class="peer-ui" data-peer-page="add"
     data-base="@Url.Action("Workspace", "PeerDiscovery")"
     data-search="@Url.Action("Search", "PeerDiscovery")"
     data-add="@Url.Action("AddPeer", "PeerDiscovery")"
     data-update-peer="@Url.Action("UpdatePeer", "PeerDiscovery")"
     data-create-group="@Url.Action("CreateGroup", "PeerDiscovery")"
     data-manage="@Url.Action("Manage", "PeerDiscovery")">
    <!-- Breadcrumb & Title -->
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <div class="mb-1 flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
                <a asp-controller="Dashboard" asp-action="Index" class="hover:text-[#114fa2] dark:hover:text-blue-300">Dashboard</a>
                <span>/</span>
                <span class="text-gray-700 dark:text-gray-300">Peer Discovery</span>
                <span>/</span>
                <span class="font-medium text-[#114fa2] dark:text-blue-400">Add Your Peer</span>
            </div>
            <h2 class="flex items-center gap-2.5 text-3xl font-bold text-gray-900 dark:text-white">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[#114fa2]/10 text-[#114fa2] dark:bg-[#114fa2]/20 dark:text-blue-400">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="8.5" cy="7" r="4" />
                        <line x1="20" y1="8" x2="20" y2="14" />
                        <line x1="23" y1="11" x2="17" y2="11" />
                    </svg>
                </span>
                Add Your Peer
            </h2>
        </div>

        <div class="flex items-center gap-3">
            <a asp-action="Manage"
               class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                View Manage Peers (<span id="peercount" data-peer-count>0</span>)
            </a>
            @* <a asp-action="Groups" class="...">Manage Peer Groups</a> *@
        </div>
    </div>

    <!-- Banner -->
    <div class="mb-6 rounded-xl border border-gray-200 border-t-2 border-t-[#114fa2] bg-gradient-to-r from-blue-50/70 via-white to-emerald-50/50 p-4 sm:p-5 dark:border-gray-800 dark:border-t-[#114fa2] dark:from-gray-800/80 dark:via-gray-800/50 dark:to-gray-800/80">
        <div class="flex items-start gap-3.5">
            <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#114fa2] text-white shadow-sm">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
            </div>
            <div class="grow">
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white">Peer Onboarding</h4>
                <p class="mt-1 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                    Enter any official business identifier: <strong>PAN</strong> (10-digits),
                    <strong>CIN</strong> (21-digits), or <strong>LLPIN</strong> (7-digits). Our intelligent
                    engine verifies compliance, pulls certified MCA &amp; GST financial profiles, and lets you map the company to your target.
                </p>
            </div>
        </div>
    </div>

@*     <p id="pp-message" class="pp-message mb-6 text-sm text-red-600 data-[ok=true]:text-emerald-600 empty:hidden" role="status" aria-live="polite">@Model.Message</p>
 *@
    <div class="grid grid-cols-12 gap-6">

        <!-- Left column -->
        <div class="col-span-12 space-y-6 xl:col-span-6">

            <div class="rounded-2xl border border-gray-200 border-t-2 border-t-[#114fa2] bg-white p-5 shadow-sm dark:border-gray-800 dark:border-t-[#114fa2] dark:bg-gray-800/90 sm:p-6">
                <div class="mb-5 flex items-center justify-between border-b border-gray-100 pb-4 dark:border-gray-700">
                    <div class="flex items-center gap-2.5">
                        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-[#114fa2] text-xs font-bold text-white">1</span>
                        <h3 class="text-base font-semibold text-gray-900 dark:text-white">Enter Peer Unique Identifier</h3>
                    </div>
                </div>

                <form id="pp-search-form" method="post" asp-action="Search" asp-antiforgery="true" class="space-y-4">

                    <div>
                        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-300">Select your input type</label>
                            <a href="https://www.instafinancials.com/" target="_blank" rel="noopener noreferrer"
                               class="group inline-flex items-center gap-1 text-xs font-medium text-[#114fa2] hover:text-blue-700 hover:underline dark:text-blue-400 dark:hover:text-blue-300">
                                <span>Need help in Finding the Unique ID? Visit InstaFinancials</span>
                                <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                    <polyline points="15 3 21 3 21 9"></polyline>
                                    <line x1="10" y1="14" x2="21" y2="3"></line>
                                </svg>
                            </a>
                        </div>

                        <div class="grid grid-cols-1 gap-2 sm:grid-cols-3" role="group" aria-label="Business identifier type">
                            <button type="button" data-type="PAN" aria-pressed="true"
                                    class="pp-type pan flex items-center justify-center rounded-lg border border-blue-200/80 bg-blue-50/50 px-2 py-2 text-xs text-blue-800 transition hover:bg-blue-100/60 aria-pressed:border-blue-500 aria-pressed:bg-blue-100/90 aria-pressed:font-semibold aria-pressed:text-blue-950 aria-pressed:ring-2 aria-pressed:ring-blue-500/20 dark:border-blue-900/40 dark:bg-blue-950/20 dark:text-blue-300 dark:aria-pressed:border-blue-400 dark:aria-pressed:bg-blue-900/50 dark:aria-pressed:text-blue-100">
                                PAN (10-char)
                            </button>
                            <button type="button" data-type="CIN" aria-pressed="false"
                                    class="pp-type cin flex items-center justify-center rounded-lg border border-purple-200/80 bg-purple-50/50 px-2 py-2 text-xs text-purple-800 transition hover:bg-purple-100/60 aria-pressed:border-purple-500 aria-pressed:bg-purple-100/90 aria-pressed:font-semibold aria-pressed:text-purple-950 aria-pressed:ring-2 aria-pressed:ring-purple-500/20 dark:border-purple-900/40 dark:bg-purple-950/20 dark:text-purple-300 dark:aria-pressed:border-purple-400 dark:aria-pressed:bg-purple-900/50 dark:aria-pressed:text-purple-100">
                                CIN (21-char)
                            </button>
                            <button type="button" data-type="LLPIN" aria-pressed="false"
                                    class="pp-type llpin flex items-center justify-center rounded-lg border border-amber-200/80 bg-amber-50/50 px-2 py-2 text-xs text-amber-800 transition hover:bg-amber-100/60 aria-pressed:border-amber-500 aria-pressed:bg-amber-100/90 aria-pressed:font-semibold aria-pressed:text-amber-950 aria-pressed:ring-2 aria-pressed:ring-amber-500/20 dark:border-amber-900/40 dark:bg-amber-950/20 dark:text-amber-300 dark:aria-pressed:border-amber-400 dark:aria-pressed:bg-amber-900/50 dark:aria-pressed:text-amber-100">
                                LLPIN (8-char)
                            </button>
                        </div>
                    </div>

                    <input type="hidden" name="IdentifierType" value="PAN" />

                    <div>
                        <label for="pp-identifier" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300">
                            Business Identifier (PAN / CIN / LLPIN) <span class="text-red-500">*</span>
                        </label>
                        <input id="pp-identifier" name="Identifier" type="text" maxlength="21" required
                               autocomplete="off" spellcheck="false" placeholder="e.g. AAACI4818J"
                               class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-3 font-mono text-sm uppercase tracking-wider text-gray-800 placeholder-gray-400 shadow-sm outline-none transition focus:border-[#114fa2] focus:ring-2 focus:ring-[#114fa2]/20 dark:border-gray-700 dark:text-white dark:placeholder-gray-500 dark:focus:border-blue-400" />
                        <p class="mt-1.5 text-[11px] text-gray-500 dark:text-gray-400">
                            PAN: AAACI4818J · CIN: L85110KA1981PLC013115 · LLPIN: AAA-0364
                        </p>
                    </div>

                    <div class="pt-2">
                        <button id="pp-search-button" type="submit"
                                class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#114fa2] px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#114fa2]/90 disabled:cursor-not-allowed disabled:opacity-50">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8" />
                                <line x1="21" y1="21" x2="16.65" y2="16.65" />
                            </svg>
                            <span>Verify &amp; Search Peer Database</span>
                        </button>

                        <div class="mt-3.5 rounded-xl border border-gray-200/90 bg-gray-50/80 p-3.5 dark:border-gray-700/80 dark:bg-gray-800/60">
                            <div class="mb-1.5 flex items-center justify-between text-xs">
                                <div class="flex items-center gap-1.5 font-semibold text-gray-700 dark:text-gray-300">
                                    <svg class="h-4 w-4 text-[#114fa2] dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    <span>Daily Search Limit &amp; Consumption</span>
                                </div>
                                <div class="font-mono text-xs font-semibold text-gray-800 dark:text-gray-200">
                                    <b id="pp-used" class="font-bold text-[#114fa2] dark:text-blue-400">@(Model.Quota?.Used ?? 0)</b>
                                    <span class="text-gray-400">/</span>
                                    <b id="pp-limit">@(Model.Quota?.DailyLimit ?? 0)</b>
                                    <span class="text-[11px] font-normal text-gray-500 dark:text-gray-400">searches</span>
                                </div>
                            </div>

                            <progress id="pp-progress"
                                      max="@(Math.Max(1, Model.Quota?.DailyLimit ?? 0))"
                                      value="@(Model.Quota?.Used ?? 0)"
                                      class="block h-2 w-full appearance-none overflow-hidden rounded-full [&::-webkit-progress-bar]:bg-gray-200 dark:[&::-webkit-progress-bar]:bg-gray-700 [&::-webkit-progress-value]:rounded-full [&::-webkit-progress-value]:bg-[#114fa2] [&::-moz-progress-bar]:bg-[#114fa2]">
                            </progress>

                            <div class="mt-2 flex items-center justify-between text-[11px] text-gray-500 dark:text-gray-400">
                                <span>
                                    <strong id="pp-remaining" class="font-semibold text-emerald-600 dark:text-emerald-400">@(Model.Quota?.Remaining ?? 0)</strong>
                                    searches remaining today
                                </span>
                                <span class="text-[10px] text-gray-400">Resets at midnight IST</span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Supported formats -->
            <div class="rounded-2xl border border-gray-200 border-t-2 border-t-[#7c3aed] bg-white p-5 shadow-sm dark:border-gray-800 dark:border-t-[#7c3aed] dark:bg-gray-800/90">
                <h4 class="mb-3 text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Supported Identifier Formats</h4>
                <div class="space-y-3 text-xs text-gray-600 dark:text-gray-300">
                    <div class="flex items-start gap-2.5">
                        <span class="rounded bg-blue-100 px-1.5 py-0.5 font-mono text-[11px] font-bold text-blue-800 dark:bg-blue-900/60 dark:text-blue-300">PAN</span>
                        <div><strong class="text-gray-800 dark:text-gray-200">Permanent Account Number (10 Chars):</strong> 5 letters, 4 digits, 1 letter. e.g. <code class="font-mono">AAACI4818J</code></div>
                    </div>
                    <div class="flex items-start gap-2.5">
                        <span class="rounded bg-purple-100 px-1.5 py-0.5 font-mono text-[11px] font-bold text-purple-800 dark:bg-purple-900/60 dark:text-purple-300">CIN</span>
                        <div><strong class="text-gray-800 dark:text-gray-200">Corporate Identification Number (21 Chars):</strong> Listing status (L/U) + 5-digit NIC + 2-digit state + 4-digit year + 3-char ownership + 6-digit reg. e.g. <code class="font-mono">L85110KA1981PLC013115</code></div>
                    </div>
                    <div class="flex items-start gap-2.5">
                        <span class="rounded bg-amber-100 px-1.5 py-0.5 font-mono text-[11px] font-bold text-amber-800 dark:bg-amber-900/60 dark:text-amber-300">LLPIN</span>
                        <div><strong class="text-gray-800 dark:text-gray-200">Limited Liability Partnership Identification Number:</strong> 3-letter prefix + 4 digits. e.g. <code class="font-mono">AAA-0364</code></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right column: results (JS renders into #pp-results) -->
        <div class="col-span-12 xl:col-span-6">
            <section id="pp-results" aria-live="polite">
                <div class="rounded-2xl border-2 border-dashed border-gray-300 border-t-2 border-t-[#114fa2] bg-gray-50/50 p-8 text-center dark:border-gray-700 dark:border-t-[#114fa2] dark:bg-gray-800/30">
                    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-white text-gray-400 shadow-sm dark:bg-gray-800">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                            <polyline points="10 9 9 9 8 9" />
                        </svg>
                    </div>
                    <h4 class="mt-4 text-sm font-semibold text-gray-700 dark:text-gray-200">Awaiting Business Identifier Input</h4>
                    <p class="mx-auto mt-1 max-w-sm text-xs text-gray-500 dark:text-gray-400">
                        Search by PAN, CIN, or LLPIN to display company or LLP information for review.
                    </p>
                </div>
            </section>
        </div>
    </div>

    @await Html.PartialAsync("_PeerUi")
</div>

@section Scripts {
    <script src="~/js/peer-discovery/peer-discovery.js" asp-append-version="true"></script>
}