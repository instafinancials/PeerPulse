@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Add Your Peer";
    ViewData["DashboardPage"] = "add-peer";
}

<div class="mx-auto max-w-[1536px]">
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <div class="mb-2 text-sm text-slate-500">
                <a asp-controller="Dashboard" asp-action="Index" class="hover:text-[#023e8a]">Dashboard</a>
                <span class="mx-1">/</span>
                <span>Peer Discovery</span>
                <span class="mx-1">/</span>
                <strong class="text-[#023e8a]">Add Your Peer</strong>
            </div>

            <h1 class="flex items-center gap-3 text-2xl font-bold text-slate-950 dark:text-white">
                <span class="grid h-10 w-10 place-items-center rounded-lg bg-[#023e8a]/10 text-[#023e8a]">
                    <i class="bi bi-person-plus text-xl"></i>
                </span>
                Add Your Peer
            </h1>
        </div>

        <a asp-controller="PeerDiscovery"
           asp-action="Manage"
           class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold shadow-sm hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800">
            <i class="bi bi-people"></i>
            View Manage Peers
        </a>
    </div>

    <div class="mb-6 rounded-xl border border-slate-200 border-t-2 border-t-[#114fa2] bg-gradient-to-r from-blue-50 via-white to-emerald-50 p-5 dark:border-slate-700 dark:from-slate-800 dark:via-slate-800 dark:to-slate-800">
        <div class="flex gap-3">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-[#023e8a] text-white">
                <i class="bi bi-search"></i>
            </span>

            <div>
                <h2 class="font-semibold">Peer Onboarding</h2>
                <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">
                    Enter PAN, GSTIN, CIN, or LLPIN. PeerPulse verifies the business profile before adding it to your selected peer group.
                </p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
        <section class="rounded-2xl border border-slate-200 border-t-2 border-t-[#114fa2] bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 sm:p-6">
            <div class="mb-5 flex items-center gap-3 border-b border-slate-100 pb-4 dark:border-slate-700">
                <span class="grid h-7 w-7 place-items-center rounded-full bg-[#023e8a] text-xs font-bold text-white">1</span>
                <h2 class="font-semibold">Enter Peer Unique Identifier</h2>
            </div>

            <form class="space-y-5">
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                    <button type="button" class="peer-type-button is-active">PAN</button>
                    <button type="button" class="peer-type-button">GSTIN</button>
                    <button type="button" class="peer-type-button">CIN</button>
                    <button type="button" class="peer-type-button">LLPIN</button>
                </div>

                <div>
                    <label class="mb-2 block text-sm font-medium">
                        Business Identifier <span class="text-red-500">*</span>
                    </label>

                    <input type="text"
                           placeholder="Enter PAN, GSTIN, CIN, or LLPIN"
                           class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 font-mono uppercase tracking-wide outline-none focus:border-[#023e8a] focus:ring-2 focus:ring-[#023e8a]/15 dark:border-slate-600 dark:bg-slate-900" />
                </div>

                <button type="submit"
                        class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[#023e8a] px-5 py-3 text-sm font-semibold text-white hover:bg-[#012e67]">
                    <i class="bi bi-search"></i>
                    Verify and Search
                </button>
            </form>
        </section>

        <section class="rounded-2xl border-2 border-dashed border-slate-300 border-t-[#114fa2] bg-slate-50/60 p-8 text-center dark:border-slate-700 dark:bg-slate-800/40">
            <div class="mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-white text-slate-400 shadow-sm dark:bg-slate-800">
                <i class="bi bi-file-earmark-text text-3xl"></i>
            </div>

            <h2 class="mt-4 font-semibold">Awaiting Business Identifier Input</h2>

            <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-500">
                Verify a PAN, GSTIN, CIN, or LLPIN to display certified company information for review.
            </p>
        </section>
    </div>
</div>