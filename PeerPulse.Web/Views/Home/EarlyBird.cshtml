@{
    ViewData["Title"] = "Early Bird Access";
    ViewData["Description"] = "Join PeerPulse Early Bird for exclusive founding member access.";
}

@section Head {
    <link rel="stylesheet" href="~/css/early-bird.css" asp-append-version="true" />
    <link rel="canonical" href="https://peerpulse.instafinancials.com/early-bird" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://peerpulse.instafinancials.com/early-bird" />
    <meta property="og:title" content="PeerPulse Early Bird – Exclusive Founding Member Access" />
    <meta property="og:description" content="Be among the first companies to experience PeerPulse." />
    <meta property="og:image" content="https://peerpulse.instafinancials.com/images/logo/logo.svg" />

    <style>
        .eb-countdown-digit {
            background: linear-gradient(135deg, rgba(2, 62, 138, 0.10) 0%, rgba(15, 155, 72, 0.08) 100%);
            border: 1px solid rgba(2, 62, 138, 0.18);
            border-radius: 12px;
            min-width: 64px;
            text-align: center;
            padding: 10px 8px 6px;
        }

        @@keyframes stripeMove {
            0% {
                background-position: 0 0;
            }

            100% {
                background-position: 40px 0;
            }
        }

        .eb-progress-stripe {
            background-image: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(255, 255, 255, 0.18) 10px, rgba(255, 255, 255, 0.18) 20px);
            background-size: 40px 40px;
            animation: stripeMove 1.2s linear infinite;
        }

       
        @@keyframes floatY {

            0%,
            100% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-7px);
            }
        }

        .eb-float {
            animation: floatY 3.5s ease-in-out infinite;
        }

      
        @@keyframes slowPulse {

            0%,
            100% {
                opacity: 0.55;
                transform: scale(1);
            }

            50% {
                opacity: 0.15;
                transform: scale(1.7);
            }
        }

        .eb-pulse-ring {
            animation: slowPulse 2.5s ease-in-out infinite;
        }

       
        .eb-privilege-card {
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

            .eb-privilege-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 20px 40px rgba(2, 62, 138, 0.10);
            }

       
        @@keyframes shimmerSlide {
            0% {
                background-position: -200% center;
            }

            100% {
                background-position: 200% center;
            }
        }

        .eb-shimmer-text {
            background: linear-gradient(90deg, #856404 0%, #ed8231 25%, #ffd203 50%, #ed8231 75%, #856404 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: shimmerSlide 2.4s linear infinite;
        }

        /* Date highlight glow */
        .eb-date-highlight {
            background: linear-gradient(135deg, #ee312b 0%, #ed8231 60%, #ffd203 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>

  <script type="text/javascript">
        (function(w, d, s, l, i) {
            w[l] = w[l] || []; w[l].push({
                'gtm.start':
                    new Date().getTime(), event: 'gtm.js'
            }); var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-T4CLN53');
    </script>
}

