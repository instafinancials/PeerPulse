@{
    ViewData["Title"] = "Know Your Competitors Better & Faster";
    ViewData["Description"] = "Benchmark confidently, outmaneuver competitors, and scale with precision using PeerPulse corporate intelligence.";
}

<div x-data="{ page: 'home', darkMode: false, mobileMenuOpen: false, pricingPeriod: 'quarterly', openFaq: 0 }"
     :class="{ 'dark bg-gray-900 text-white': darkMode, 'bg-[#fcfdfd] text-gray-800': !darkMode }"
     class="font-inter antialiased selection:bg-[#0f9b48]/20 selection:text-[#023e8a]">

    <!-- ========================================================================= -->
    <!-- NAVIGATION HEADER                                                         -->
    <!-- ========================================================================= -->
    <header class="sticky top-0 z-50 backdrop-blur-md transition-all duration-300 border-b border-gray-200/80 bg-white/90 dark:bg-gray-900/90 dark:border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">

                <!-- Logo & Brand -->
                <div class="flex items-center gap-3">
                    <a herf="#hero" class="flex items-center gap-2.5 group">
                        <img src="../images/logo/logo-icon.svg" asp-append-version="true" alt="PeerPulse Logo" class="h-12 w-12" width="48" height="48" />
                        <div>
                            <div class="flex items-center gap-1.5">
                                <span class="text-2xl font-extrabold tracking-tight text-[#023e8a] dark:text-white">
                                    Peer<span class="text-[#0f9b48]">Pulse</span>
                                </span>
                                <span class="text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-[#0f9b48]/10 text-[#0f9b48] border border-[#0f9b48]/20">Pro</span>
                            </div>
                            <p class="text-[11px] font-medium text-gray-500 dark:text-gray-400 leading-none">by InstaFinancials</p>
                        </div>
                    </a>
                </div>

                <!-- Desktop Navigation Links -->
                <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-600 dark:text-gray-300">
                    <a href="#discovery" class="hover:text-[#023e8a] dark:hover:text-[#36bffa] transition-colors">
                        Intelligence
                        Matrix
                    </a>
                    <a href="#capabilities"
                       class="hover:text-[#023e8a] dark:hover:text-[#36bffa] transition-colors">Capabilities</a>
                    <a href="#pricing" class="hover:text-[#023e8a] dark:hover:text-[#36bffa] transition-colors">Pricing</a>
                    <a href="#faq" class="hover:text-[#023e8a] dark:hover:text-[#36bffa] transition-colors">FAQ</a>
                    <a href="#" @* asp-controller="Account"
                       asp-action="Login" *@
                       class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-[#114fa2]/10 text-[#023e8a] dark:text-[#7cd4fd] hover:bg-[#114fa2]/20 transition-colors">
                        <span class="w-2 h-2 rounded-full bg-[#0f9b48] animate-pulse"></span>
                        Live Demo Dashboard
                    </a>
                </nav>

                <!-- CTAs & Theme Toggle -->
                <div class="hidden lg:flex items-center gap-3">
                    <!-- Dark Mode Toggle -->
                    <button @@click="darkMode = !darkMode" type="button"
                        class="p-2 rounded-lg text-gray-500 hover:text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800 transition-colors"
                        aria-label="Toggle theme">
                        <template x-if="!darkMode">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                            </svg>
                        </template>
                        <template x-if="darkMode">
                            <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z">
                                </path>
                            </svg>
                        </template>
                    </button>

                    <!-- Secondary CTA (Primary Dark Blue) -->
                    <a href="#pricing" class="btn-secondary-cta text-xs px-3.5 py-2">
                        Book a Strategy Demo
                    </a>

                    <!-- Primary CTA (Primary Green) -->
                    <a asp-controller="Home" asp-action="EarlyBird" class="btn-primary-cta text-xs px-4 py-2">
                        @*  Start Free Comparison *@Claim Early Bird Access
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                        </svg>
                    </a>
                </div>

                <!-- Mobile Menu Toggle Button -->
                <div class="flex items-center gap-2 md:hidden">
                    <button @@click="mobileMenuOpen = !mobileMenuOpen" type="button"
                        class="p-2 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800"
                        aria-label="Open mobile menu">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path x-show="!mobileMenuOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M4 6h16M4 12h16M4 18h16"></path>
                            <path x-show="mobileMenuOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Dropdown Menu -->
        <div x-show="mobileMenuOpen" x-collapse
             class="md:hidden border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 px-4 pt-3 pb-6 space-y-3">
            <a @@click="mobileMenuOpen = false" href="#discovery"
            class="block py-2 text-sm font-medium text-gray-700 dark:text-gray-200">Intelligence Matrix</a>
            <a @@click="mobileMenuOpen = false" href="#capabilities"
            class="block py-2 text-sm font-medium text-gray-700 dark:text-gray-200">Capabilities</a>
            <a @@click="mobileMenuOpen = false" href="#pricing"
            class="block py-2 text-sm font-medium text-gray-700 dark:text-gray-200">Pricing</a>
            <a @@click="mobileMenuOpen = false" href="#faq"
            class="block py-2 text-sm font-medium text-gray-700 dark:text-gray-200">FAQ</a>
            <a @@click="mobileMenuOpen = false" href="#"
            class="block py-2 text-sm font-medium text-[#023e8a] dark:text-[#36bffa]">Interactive Dashboard</a>
            <div class="pt-2 flex flex-col gap-2">
                <a href="#" class="btn-primary-cta w-full text-center">Start Free Comparison</a>
                <a href="#pricing" class="btn-secondary-cta w-full text-center">Book a Strategy Demo</a>
            </div>
        </div>
    </header>


    <!-- ========================================================================= -->
    <!-- SECTION 1: AWARENESS (Hero & Above the Fold)                              -->
    <!-- ========================================================================= -->
    <section id="hero" class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28">
        <!-- Ambient background glows with brand colors -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[850px] h-[450px] bg-gradient-to-tr from-[#023e8a]/10 via-[#0f9b48]/8 to-[#ffd203]/5 rounded-full blur-3xl pointer-events-none -z-10">
        </div>
        <div class="absolute top-1/3 -right-20 w-80 h-80 bg-[#114fa2]/10 rounded-full blur-2xl pointer-events-none -z-10">
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- Eyebrow Pill -->
            <div class="flex justify-center mb-6">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-[#023e8a]/10 via-[#114fa2]/10 to-[#0f9b48]/15 border border-[#0f9b48]/30 shadow-xs">
                    <span class="flex h-2 w-2 relative">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#1fb14c] opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-[#0f9b48]"></span>
                    </span>
                    <span class="text-xs sm:text-sm font-semibold tracking-wide text-[#023e8a] dark:text-[#66d28c]">
                        Corporate Intelligence &amp; Competitive Benchmarking Platform
                    </span>
                </div>
            </div>

            <!-- Main Headline & Subheadline -->
            <div class="text-center max-w-4xl mx-auto mb-10">
                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-gray-900 dark:text-white leading-[1.15] mb-6">
                    Feel the Market's Pulse <br class="hidden sm:block" />
                    <span class="bg-gradient-to-r from-[#023e8a] via-[#114fa2] to-[#0f9b48] bg-clip-text text-transparent">
                        Outsmart Competitors.
                    </span> <br class="hidden sm:block" />
                    Anticipate Next Moves.
                </h1>

                <p class="text-base sm:text-lg lg:text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto leading-relaxed">
                    PeerPulse aggregates regulatory filings, corporate structures, statutory compliances, website technical
                    profiles & performance, and
                    digital footprint analytics into unified, board-ready competitor benchmarking reports with <span class="text-[#023e8a] dark:text-[#7cd4fd] font-bold">AI powered</span> recommendations.
                </p>

                <!-- Hero CTA Buttons -->
                <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-6">
                    <!-- Primary CTA Button (Primary Green) -->
                    <a herf="#"
                     @*   asp-controller="Account"
                       asp-action="Login" *@
                       class="btn-primary-cta text-base px-8 py-3.5 w-full sm:w-auto shadow-lg shadow-[#0f9b48]/25 hover:shadow-[#0f9b48]/40 hover:-translate-y-0.5 transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z">
                            </path>
                        </svg>
                        Start Free Comparison
                    </a>

                    <!-- Secondary CTA Button (Primary Dark Blue BG) -->
                    <a href="#pricing"
                       class="btn-secondary-cta text-base px-7 py-3.5 w-full sm:w-auto shadow-lg shadow-[#023e8a]/20 hover:shadow-[#023e8a]/35 hover:-translate-y-0.5 transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        Book a Strategy Demo
                    </a>
                </div>
            </div>


            <!-- Trust Proof Strip -->
            <div class="max-w-5xl mx-auto mt-6 mb-12">
                <div class="rounded-2xl bg-white dark:bg-gray-800/80 border border-gray-200/80 dark:border-gray-700/80 p-5 shadow-xs subtle-border-green">
                    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-[#0f9b48]/10 text-[#0f9b48] flex items-center justify-center shrink-0">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z">
                                    </path>
                                </svg>
                            </div>
                            <div>
                                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    Verified Indian Registry Data
                                </p>
                                <p class="text-sm sm:text-base font-bold text-gray-900 dark:text-white">
                                    Aggregating statutory and public intelligence across <span class="text-[#023e8a] dark:text-[#36bffa]">35 Lakh+</span> registered corporate & <span class="text-[#023e8a] dark:text-[#36bffa]">1.5 Crore+</span> GSTIN entities in India.
                                </p>
                            </div>
                        </div>
                        <!-- Live Counter Badges -->
                        <div class="flex flex-col gap-2 shrink-0 lg:items-end items-center max-w-xl">
                            <!-- Row 1: Statutory, Regulatory & Legal Intelligence -->
                            <div class="flex flex-wrap items-center justify-center lg:justify-end gap-2">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-[#023e8a]/10 text-[#023e8a] dark:text-[#7cd4fd] border border-[#023e8a]/20">
                                    MCA
                                    / ROC
                                </span>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-[#0f9b48]/10 text-[#0f9b48] dark:text-[#66d28c] border border-[#0f9b48]/20">GSTIN</span>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-[#ffd203]/20 text-[#856404] dark:text-[#ffd203] border border-[#ffd203]/30">EPFO</span>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-[#ee312b]/10 text-[#ee312b] dark:text-[#ff807d] border border-[#ee312b]/20">eCourts</span>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-[#114fa2]/10 text-[#023e8a] dark:text-[#7cd4fd] border border-[#114fa2]/20">
                                    Social
                                    Media
                                </span>
                            </div>
                            <!-- Row 2: Digital, Technology & Corporate DNA -->
                            <div class="flex flex-wrap items-center justify-center lg:justify-end gap-2">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-[#0f9b48]/10 text-[#0f9b48] dark:text-[#66d28c] border border-[#0f9b48]/20">
                                    Website
                                    Tech
                                </span>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-[#7c3aed]/10 text-[#7c3aed] dark:text-[#c4b5fd] border border-[#7c3aed]/20">
                                    Tech
                                    Stack
                                </span>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-[#ed8231]/15 text-[#ed8231] dark:text-[#ffaa6b] border border-[#ed8231]/20">
                                    Patents
                                    &amp; Trademarks
                                </span>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-[#0284c7]/10 text-[#0284c7] dark:text-[#38bdf8] border border-[#0284c7]/20">
                                    Leadership
                                    Team
                                </span>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-[#059669]/10 text-[#059669] dark:text-[#34d399] border border-[#059669]/20">
                                    Certifications
                                    &amp; Awards
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </section>


    <!-- ========================================================================= -->
    <!-- SECTION 2: INTEREST (Discovery, Unified Intelligence & Segmentation)      -->
    <!-- ========================================================================= -->
    <section id="discovery" class="py-20 bg-gray-50 dark:bg-gray-900/60 border-y border-gray-200 dark:border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- Section Header -->
            <div class="text-center max-w-3xl mx-auto mb-16">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#114fa2]/10 text-[#023e8a] dark:text-[#7cd4fd] text-xs font-bold uppercase tracking-wider mb-3">
                    Discover, Analyse & Monitor
                </div>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4">
                    The 360° Competitor Intelligence Surface
                </h2>
                <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300">
                    Still learning who your competitors are from your lost prospects? Stop guessing and start Discovering,
                    Analysing and Monitoring your competitors.
                </p>
            </div>

            <!-- Subsection 1: Intelligent Discovery by Industry DNA -->
            <div class="mb-20">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                    <!-- Card 1: Discovery -->
                    <div class="rounded-2xl bg-white dark:bg-gray-800 p-6 border border-gray-200 dark:border-gray-700 shadow-xs hover:shadow-md transition-shadow subtle-border-blue">
                        <div class="w-12 h-12 rounded-xl bg-[#023e8a]/10 text-[#023e8a] dark:text-[#6699d1] flex items-center justify-center mb-4">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                        </div>
                        <h4 class="text-lg font-bold text-[#023e8a] dark:text-white mb-2">Discover Your Peers</h4>
                        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                            Discover your competitors using MCA national industry classifications and product-level GST codes,
                            revenue, geographical and industry parameters.
                        </p>
                        <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 flex items-center text-xs font-semibold text-[#023e8a]">
                            <span>35 Lakh Companies & 1.5 Crore GSTINs</span>
                        </div>
                    </div>

                    <!-- Card 2: Analyse Peer -->
                    <div class="rounded-2xl bg-white dark:bg-gray-800 p-6 border border-gray-200 dark:border-gray-700 shadow-xs hover:shadow-md transition-shadow subtle-border-green">
                        <div class="w-12 h-12 rounded-xl bg-[#0f9b48]/10 text-[#0f9b48] flex items-center justify-center mb-4">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                                </path>
                            </svg>
                        </div>
                        <h4 class="text-lg font-bold text-[#0f9b48] dark:text-white mb-2">Analyse Your Peers</h4>
                        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                            With PeerPulse Report, get microscopic view of your peer performanceusing intelligent analytics,
                            benchmarking and AI recommendations.
                        </p>
                        <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 flex items-center text-xs font-semibold text-[#0f9b48]">
                            <span>250+ financial and thousands of key signals</span>
                        </div>
                    </div>

                    <!-- Card 3: Monitor Peers -->
                    <div class="rounded-2xl bg-white dark:bg-gray-800 p-6 border border-gray-200 dark:border-gray-700 shadow-xs hover:shadow-md transition-shadow subtle-border-orange">
                        <div class="w-12 h-12 rounded-xl bg-[#ed8231]/10 text-[#ed8231] flex items-center justify-center mb-4">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7">
                                </path>
                            </svg>
                        </div>
                        <h4 class="text-lg font-bold text-[#ed8231] dark:text-white mb-2">Monitor Your Peers</h4>
                        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                            Cluster competitors across business units, subsidiaries, or independent product lines to prevent
                            apples-to-oranges financial evaluations.
                        </p>
                        <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 flex items-center text-xs font-semibold text-[#ed8231]">
                            <span>Multi-vertical watchlist clustering</span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Subsection 2: Comprehensive 10-Layer Peer Intelligence Matrix -->
            <div>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-2.5">
                        Comprehensive Multi-Layer Peer Intelligence Matrix
                    </h3>
                    <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-[#023e8a]/10 text-[#023e8a] dark:text-[#7cd4fd] self-start sm:self-auto">
                        250+ Financial • 1000+ Business Signals
                    </span>
                </div>

                <!-- 10-Layer Matrix Table Card -->
                <div class="rounded-2xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-md overflow-hidden subtle-border-primary">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-50/80 dark:bg-gray-900/80 border-b border-gray-200 dark:border-gray-700 text-xs font-bold uppercase tracking-wider text-gray-600 dark:text-gray-300">
                                    <th scope="col" class="py-4 px-6 w-1/4">Intelligence Vector</th>
                                    <th scope="col" class="py-4 px-6 w-2/4">Data Points &amp; Coverage</th>
                                    <th scope="col" class="py-4 px-6 w-1/4 text-right">Cadence &amp; Source</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 dark:divide-gray-700/60 text-sm">

                                <!-- Row 1: Registry & Legal -->
                                <tr class="hover:bg-blue-50/30 dark:hover:bg-gray-700/30 transition-colors">
                                    <td class="py-4 px-6 font-bold text-gray-900 dark:text-white flex items-center gap-2">
                                        <span class="w-2 h-2 rounded-full bg-[#023e8a]"></span>
                                        Registry &amp; Legal
                                    </td>
                                    <td class="py-4 px-6 text-gray-600 dark:text-gray-300">
                                        CIN, ROC jurisdiction, incorporation date, authorized vs. paid-up capital, status under CIRP.
                                    </td>
                                    <td class="py-4 px-6 text-right">
                                        <span class="inline-flex px-2.5 py-1 rounded text-xs font-medium bg-[#023e8a]/10 text-[#023e8a] dark:text-[#6699d1]">
                                            MCA
                                            / Real-time
                                        </span>
                                    </td>
                                </tr>

