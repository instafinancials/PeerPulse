@model PeerPulse.Web.ViewModels.PeerDiscovery.CreatePeerGroupViewModel

<button type="button"
        class="inline-flex items-center gap-2 rounded-lg bg-[#114fa2] px-4 py-2.5 text-xs font-semibold text-white shadow-sm hover:bg-[#0d438a]"
        onclick="document.getElementById('createPeerGroupDialog').showModal()">
    <i class="bi bi-plus-lg"></i>
    Create Peer Group
</button>

<dialog id="createPeerGroupDialog"
        class="w-full max-w-lg rounded-2xl border-0 bg-transparent p-4 backdrop:bg-slate-950/50">
    <div class="rounded-2xl border-t-4 border-t-violet-600 bg-white p-6 shadow-2xl">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <div>
                <h3 class="text-base font-bold text-slate-900">Create Peer Group</h3>
                <p class="mt-1 text-xs text-slate-500">
                    Create a group before adding companies.
                </p>
            </div>

            <button type="button"
                    class="rounded-lg p-2 text-slate-400 hover:bg-slate-100"
                    onclick="document.getElementById('createPeerGroupDialog').close()"
                    aria-label="Close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <form asp-controller="PeerDiscovery"
              asp-action="CreateGroup"
              method="post"
              class="mt-5 space-y-4">

            @Html.AntiForgeryToken()
            <input asp-for="ReturnUrl" type="hidden" />

            <div>
                <label asp-for="Name" class="mb-1.5 block text-xs font-semibold text-slate-700">
                    Peer Group Name <span class="text-red-600">*</span>
                </label>

                <input asp-for="Name"
                       placeholder="Example: Enterprise SaaS & Cloud"
                       class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-[#114fa2] focus:ring-2 focus:ring-blue-100" />

                <span asp-validation-for="Name" class="mt-1 text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="BusinessVertical" class="mb-1.5 block text-xs font-semibold text-slate-700">
                    Business Vertical / Product Line
                </label>

                <input asp-for="BusinessVertical"
                       placeholder="Example: Financial Services"
                       class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-[#114fa2] focus:ring-2 focus:ring-blue-100" />
            </div>

            <div>
                <label asp-for="Description" class="mb-1.5 block text-xs font-semibold text-slate-700">
                    Cohort Description
                </label>

                <textarea asp-for="Description"
                          rows="3"
                          placeholder="Describe the companies and benchmark focus..."
                          class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-[#114fa2] focus:ring-2 focus:ring-blue-100"></textarea>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button"
                        class="rounded-lg border border-slate-300 px-4 py-2 text-xs font-semibold text-slate-700"
                        onclick="document.getElementById('createPeerGroupDialog').close()">
                    Cancel
                </button>

                <button type="submit"
                        class="rounded-lg bg-[#114fa2] px-4 py-2 text-xs font-semibold text-white hover:bg-[#0d438a]">
                    Create Group
                </button>
            </div>
        </form>
    </div>
</dialog>