@{
    var profileName = string.IsNullOrWhiteSpace(User.Identity?.Name)
        ? "PeerPulse User"
        : User.Identity!.Name!;

    var profileEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
        ?? "support@instafinancials.com";

    var profileInitial = profileName.Substring(0, 1).ToUpperInvariant();
}



<header class="sticky top-0 z-30 flex min-h-[76px] items-center justify-between border-b border-slate-200 bg-white px-4 md:px-6 dark:border-slate-800 dark:bg-slate-900">

    <div class="flex items-center gap-3">
        <button type="button"
            @@click="sidebarOpen = !sidebarOpen"
                class="grid h-11 w-11 place-items-center rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 lg:hidden dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">
            <i class="bi bi-list text-xl"></i>
        </button>

        <div class="hidden lg:block">
            <div class="relative w-[360px] xl:w-[430px]">
                <i class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="search" placeholder="Search or type command..."
                       class="h-11 w-full rounded-lg border border-slate-200 bg-white py-2 pl-11 pr-16 text-sm outline-none transition focus:border-[#023e8a] focus:ring-2 focus:ring-[#023e8a]/15 dark:border-slate-700 dark:bg-slate-800" />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 rounded-md border border-slate-200 bg-slate-50 px-2 py-1 text-xs text-slate-500 dark:border-slate-700 dark:bg-slate-900">
                    ⌘ K
                </span>
            </div>
        </div>
    </div>

    <div class="flex items-center gap-2">
        <button type="button"
            @@click="darkMode = !darkMode"
                class="grid h-11 w-11 place-items-center rounded-full border border-slate-200 text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">
            <i class="bi bi-moon-stars" x-show="!darkMode"></i>
            <i class="bi bi-sun" x-show="darkMode"></i>
        </button>

        <button type="button"
                class="relative grid h-11 w-11 place-items-center rounded-full border border-slate-200 text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">
            <span class="absolute right-2 top-2 h-2 w-2 rounded-full bg-[#ed8231]"></span>
            <i class="bi bi-bell"></i>
        </button>

        @*  <div class="hidden border-l border-slate-200 pl-3 sm:flex sm:items-center sm:gap-2 dark:border-slate-700">
            <div class="grid h-10 w-10 place-items-center rounded-full bg-[#023e8a] text-sm font-bold text-white">
                @(User.Identity?.Name?.Substring(0, 1).ToUpperInvariant() ?? "U")
            </div>

            <span class="max-w-28 truncate text-sm font-semibold">
                @(User.Identity?.Name ?? "PeerPulse User")
            </span>
        </div> *@
   
        <div class="relative hidden border-l border-slate-200 pl-3 sm:block dark:border-slate-700"
             x-data="{ profileOpen: false }"
            @@keydown.escape.window="profileOpen = false">

            <button type="button"
                @@click="profileOpen = !profileOpen"
                    :aria-expanded="profileOpen"
                    class="flex items-center gap-2 rounded-lg px-1 py-1 text-left transition hover:bg-slate-50 dark:hover:bg-slate-800">

                <div class="grid h-10 w-10 place-items-center rounded-full bg-[#023e8a] text-sm font-bold text-white">
                    @profileInitial
                </div>

                <span class="max-w-28 truncate text-sm font-semibold text-slate-700 dark:text-slate-200">
                    @profileName
                </span>

                <i class="bi bi-chevron-down text-xs text-slate-500 transition-transform dark:text-slate-400"
                   :class="{ 'rotate-180': profileOpen }"></i>
            </button>

            <div x-cloak
                 x-show="profileOpen"
                @@click.outside="profileOpen = false"
                 x-transition:enter="transition ease-out duration-150"
                 x-transition:enter-start="scale-95 opacity-0"
                 x-transition:enter-end="scale-100 opacity-100"
                 x-transition:leave="transition ease-in duration-100"
                 x-transition:leave-start="scale-100 opacity-100"
                 x-transition:leave-end="scale-95 opacity-0"
                 class="absolute right-0 top-[calc(100%+14px)] z-50 w-[260px] overflow-hidden rounded-2xl border border-slate-200 bg-white py-2 shadow-xl shadow-slate-900/10 dark:border-slate-700 dark:bg-slate-800">

                <div class="border-b border-slate-200 px-5 pb-4 pt-2 dark:border-slate-700">
                    <p class="truncate text-sm font-semibold text-slate-700 dark:text-slate-100">
                        @profileName
                    </p>
                    <p class="mt-1 truncate text-xs text-slate-500 dark:text-slate-400">
                        @profileEmail
                    </p>
                </div>

                <div class="p-2">
                    <a asp-controller="Account" asp-action="EditProfile"
                        @@click="profileOpen = false"
                       class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:text-[#023e8a] dark:text-slate-300 dark:hover:bg-slate-700">
                        <i class="bi bi-person-circle text-xl"></i>
                        Edit profile
                    </a>

                    <a asp-controller="Account" asp-action="Settings"
                        @@click="profileOpen = false"
                       class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:text-[#023e8a] dark:text-slate-300 dark:hover:bg-slate-700">
                        <i class="bi bi-gear text-xl"></i>
                        Account settings
                    </a>

                    <a asp-controller="Support" asp-action="Index"
                        @@click="profileOpen = false"
                       class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:text-[#023e8a] dark:text-slate-300 dark:hover:bg-slate-700">
                        <i class="bi bi-info-circle text-xl"></i>
                        Support
                    </a>
                </div>

                <div class="mx-5 border-t border-slate-200 dark:border-slate-700"></div>

                <form asp-controller="Account" asp-action="Logout" method="post" class="p-2">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="flex w-full items-center gap-3 rounded-xl px-3 py-3 text-left text-sm font-medium text-slate-600 hover:bg-red-50 hover:text-red-600 dark:text-slate-300 dark:hover:bg-red-950/30">
                        <i class="bi bi-box-arrow-right text-xl"></i>
                        Sign out
                    </button>
                </form>
            </div>
        </div>
    </div>
</header>