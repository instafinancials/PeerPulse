<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    <title>@ViewData["Title"] - PeerPulse</title>

    <meta name="description" content="@ViewData["Description"]" />

    <meta name="author" content="InstaFinancials" />

    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <link rel="canonical" href="https://peerpulse.instafinancials.com" />

    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />

    <!-- Google font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Central stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PeerPulse.Web.styles.css" asp-append-version="true" />
    <!-- jQuery: load before views and other scripts -->
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <link rel="stylesheet" href="~/font-awesome/css/font-awesome.min.css" />
    <!-- Tailwind -->
    <script src="~/lib/tailwind/tailwind.js" asp-append-version="true">    </script>

    <script>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        fontFamily: {
                            inter: ["Inter", "sans-serif"]
                        }
                    }
                }
            };
    </script>

    @await RenderSectionAsync("Head", required: false)
</head>

<body class="font-inter antialiased">

    @RenderBody()

    <!-- Alpine -->
    <script defer
            src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js">
    </script>

    <!-- Application JavaScript -->
    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    <!-- Page-specific scripts -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>