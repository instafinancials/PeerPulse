@{
    Layout = "_Layout";
}

<div x-data="{
    sidebarOpen: false,
    darkMode: localStorage.getItem('peerpulse-dark-mode') === 'true'
    }"
     x-init="$watch('darkMode', v => localStorage.setItem('peerpulse-dark-mode', v))"
     :class="{ 'dark': darkMode }"
     class="bg-[#f7f9fc] font-inter text-slate-800 dark:bg-gray-900 dark:text-gray-100">

    <div class="flex h-screen overflow-hidden">
        <partial name="_DashboardSidebar" />

        <div class="relative flex min-w-0 flex-1 flex-col overflow-x-hidden overflow-y-auto bg-[#f7f9fc] dark:bg-gray-900">
            <partial name="_DashboardHeader" />

            <main>
                <div class="mx-auto max-w-screen-2xl p-4 md:p-6 lg:p-8">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}