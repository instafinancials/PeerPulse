@{
    Layout = "_Layout";
}

<div x-data="{ sidebarToggle: false }" x-on:keydown.escape.window="sidebarToggle = false" class="flex h-screen overflow-hidden bg-gray-50 text-gray-800 dark:bg-gray-900 dark:text-gray-100">
    <partial name="_DashboardSidebar" />
    <div class="relative flex min-w-0 flex-1 flex-col overflow-x-hidden overflow-y-auto bg-gray-50 dark:bg-gray-900">
        <div x-on:click="sidebarToggle = false" x-bind:class="sidebarToggle ? 'block lg:hidden' : 'hidden'" class="fixed w-full h-screen z-9 bg-gray-900/50"></div>
        <partial name="_DashboardHeader" />
        <main>
            <div class="p-4 mx-auto max-w-(--breakpoint-2xl) md:p-6 lg:p-8">
                @RenderBody()
            </div>
        </main>
    </div>
</div>

@section Head {
    @await RenderSectionAsync("Head", required: false)
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
