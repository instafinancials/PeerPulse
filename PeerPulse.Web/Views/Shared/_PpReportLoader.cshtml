<div id="pp-report-loader" class="pp-report-loader" hidden role="status"
     aria-live="polite" aria-atomic="true" aria-labelledby="pp-report-loader-title">
    <div class="pp-report-loader__card">
        <div class="pp-report-loader__mark" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none">
                <rect x="8" y="25" width="7" height="15" rx="2" fill="currentColor" />
                <rect x="21" y="17" width="7" height="23" rx="2" fill="currentColor" opacity=".75" />
                <rect x="34" y="8" width="7" height="32" rx="2" fill="currentColor" opacity=".5" />
            </svg>
            <span class="pp-report-loader__ring"></span>
        </div>
        <p class="pp-report-loader__eyebrow">PEERPULSE</p>
        <h2 id="pp-report-loader-title">Preparing your comparison</h2>
        <p id="pp-report-loader-message">Retrieving your selected peers and building the report.</p>
        <div class="pp-report-loader__track" aria-hidden="true"><span></span></div>
        <p class="pp-report-loader__hint">This can take a few moments.</p>
        <button id="pp-report-loader-dismiss" type="button" class="pp-report-loader__dismiss" hidden>
            Hide loading message
        </button>
    </div>
</div>
