@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Report Preferences";
    ViewData["DashboardPage"] = "Report-Preferences";
}

<section x-data="peerComparePreferencesApp()"
         data-load="@Url.Action("PreferenceData", "ReportSettings")"
         data-save="@Url.Action("SavePreferences", "ReportSettings")"
         data-preference-save="@Url.Action("SavePreferences", "ReportSettings")"
         data-select="@Url.Action("SelectPeer", "ReportSettings")" class="flex-1">
    @Html.AntiForgeryToken()
    <partial name="_ReportSettingsStatus" />
    <fieldset x-bind:disabled="!ready || busy" class="min-w-0 border-0 p-0 m-0">

        <div class="mx-auto w-full">

            <!-- Breadcrumbs & Header -->
            <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-1">
                        <span class="text-gray-700 dark:text-gray-300">PeerCompare</span>
                        <span>/</span>
                        <span class="font-medium text-brand-primary-blue dark:text-brand-400">Report Preferences</span>
                    </div>
                    <h2 class="text-title-sm font-bold text-gray-900 dark:text-white flex items-center gap-2.5">
                        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-primary-blue/10 text-brand-primary-blue dark:bg-brand-primary-blue/20 dark:text-blue-400">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="3" x2="12" y2="21" />
                                <path d="M4 7l8-4 8 4" />
                                <path d="M6 18H2l3-7 3 7H6z" />
                                <path d="M20 18h-4l3-7 3 7h-2z" />
                            </svg>
                        </span>
                        PeerCompare - Report Preferences
                    </h2>
                </div>

                <!-- Wizard Step Navigator -->
                <div class="flex items-center gap-2 bg-gray-100 p-1.5 rounded-xl dark:bg-gray-800 text-xs font-semibold">
                    <span class="flex items-center gap-1.5 rounded-lg bg-brand-primary-blue px-3 py-1.5 text-white shadow-xs">
                        Report Preferences
                    </span>
                    <a asp-controller="ReportSettings" asp-action="SelectPeer" x-on:click.prevent="proceedToSelect()" class="flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white transition-colors">
                        Select Peers
                    </a>
                    <a asp-controller="ReportSettings" asp-action="Report" class="flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white transition-colors">
                        View Report
                    </a>
                </div>
            </div>

            <!-- Notification Toast -->
            <div x-show="savedToast" x-cloak
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 -translate-y-2"
                 x-transition:enter-end="opacity-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100 translate-y-0"
                 x-transition:leave-end="opacity-0 -translate-y-2"
                 class="mb-6 flex items-center justify-between rounded-xl bg-emerald-500 px-4 py-3 text-white shadow-lg">
                <div class="flex items-center gap-2 text-sm font-medium">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Report preferences updated and saved successfully!</span>
                </div>
                <button x-on:click="savedToast = false" class="text-white/80 hover:text-white">✕</button>
            </div>

            <!-- Main Configuration Card -->
            <div class="grid grid-cols-12 gap-6">

                <!-- Left Col: Form Settings -->
                <div class="col-span-12 xl:col-span-8 space-y-6">

                    <!-- Preference Card 1: Currency Selection -->
                    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs dark:border-gray-800 dark:bg-gray-800">
                        <div class="flex items-center justify-between border-b border-gray-100 pb-4 dark:border-gray-700">
                            <div class="flex items-center gap-3">
                                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-brand-primary-blue font-bold text-xs dark:bg-blue-900/40 dark:text-blue-300">
                                    1
                                </span>
                                <div>
                                    <h3 class="text-base font-bold text-gray-900 dark:text-white">
                                        Reporting Currency
                                    </h3>
                                    <p class="text-xs text-gray-500 dark:text-gray-400">
                                        Select the base currency for displaying company financials and capital metrics.
                                    </p>
                                </div>
                            </div>
                            <span class="rounded bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300" x-text="preferences.currency"></span>
                        </div>

                        <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
                            <!-- INR Option -->
                            <div role="button" tabindex="0"
                                 x-on:keydown.enter.prevent="setCurrency('INR')"
                                 x-on:keydown.space.prevent="setCurrency('INR')"
                                 x-on:click="setCurrency('INR')"
                                 x-bind:class="preferences.currency === 'INR' ? 'border-brand-primary-blue bg-blue-50/50 ring-2 ring-brand-primary-blue/20 dark:bg-blue-900/20 dark:border-blue-500' : 'border-gray-200 hover:border-gray-300 dark:border-gray-700'"
                                 class="cursor-pointer rounded-xl border p-4 transition-all flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-100 text-emerald-700 font-bold text-lg dark:bg-emerald-950 dark:text-emerald-300">
                                        ₹
                                    </div>
                                    <div>
                                        <h4 class="text-sm font-bold text-gray-900 dark:text-white">INR - Indian Rupee</h4>
                                        <p class="text-xs text-gray-500 dark:text-gray-400">Official currency of MCA statutory filings</p>
                                    </div>
                                </div>
                                <input type="radio" value="INR" x-model="preferences.currency" x-on:change="savePreferences(false)" class="text-brand-primary-blue" />
                            </div>

                            <!-- USD Option -->
                            <div role="button" tabindex="0"
                                 x-on:keydown.enter.prevent="setCurrency('USD')"
                                 x-on:keydown.space.prevent="setCurrency('USD')"
                                 x-on:click="setCurrency('USD')"
                                 x-bind:class="preferences.currency === 'USD' ? 'border-brand-primary-blue bg-blue-50/50 ring-2 ring-brand-primary-blue/20 dark:bg-blue-900/20 dark:border-blue-500' : 'border-gray-200 hover:border-gray-300 dark:border-gray-700'"
                                 class="cursor-pointer rounded-xl border p-4 transition-all flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-100 text-blue-700 font-bold text-lg dark:bg-blue-950 dark:text-blue-300">
                                        $
                                    </div>
                                    <div>
                                        <h4 class="text-sm font-bold text-gray-900 dark:text-white">USD - US Dollar</h4>
                                        <p class="text-xs text-gray-500 dark:text-gray-400">Converted using customizable USD/INR exchange rate</p>
                                    </div>
                                </div>
                                <input type="radio" value="USD" x-model="preferences.currency" x-on:change="savePreferences(false)" class="text-brand-primary-blue" />
                            </div>
                        </div>
                    </div>

                    <!-- Preference Card 2: Financial Numbers Format -->
                    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs dark:border-gray-800 dark:bg-gray-800">
                        <div class="flex items-center justify-between border-b border-gray-100 pb-4 dark:border-gray-700">
                            <div class="flex items-center gap-3">
                                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-brand-primary-blue font-bold text-xs dark:bg-blue-900/40 dark:text-blue-300">
                                    2
                                </span>
                                <div>
                                    <h3 class="text-base font-bold text-gray-900 dark:text-white">
                                        Financial Numbers Format
                                    </h3>
                                    <p class="text-xs text-gray-500 dark:text-gray-400">
                                        Choose how numerical figures and capital numbers are scaled across tables and charts.
                                    </p>
                                </div>
                            </div>
                            <span class="rounded bg-blue-50 px-2 py-0.5 text-xs font-semibold text-brand-primary-blue dark:bg-blue-900/40 dark:text-blue-300 capitalize" x-text="preferences.financialFormat"></span>
                        </div>

                        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">

                            <!-- Absolute Values -->
                            <div role="button" tabindex="0"
                                 x-on:keydown.enter.prevent="setFormat('absolute')"
                                 x-on:keydown.space.prevent="setFormat('absolute')"
                                 x-on:click="setFormat('absolute')"
                                 x-bind:class="preferences.financialFormat === 'absolute' ? 'border-brand-primary-blue bg-blue-50/50 ring-2 ring-brand-primary-blue/20 dark:bg-blue-900/20 dark:border-blue-500' : 'border-gray-200 hover:border-gray-300 dark:border-gray-700'"
                                 class="cursor-pointer rounded-xl border p-4 transition-all">
                                <div class="flex items-center justify-between">
                                    <span class="text-sm font-bold text-gray-900 dark:text-white">Absolute Values</span>
                                    <input type="radio" value="absolute" x-model="preferences.financialFormat" x-on:change="savePreferences(false)" class="text-brand-primary-blue" />
                                </div>
                                <p class="mt-1 text-[11px] text-gray-500 dark:text-gray-400">Full unscaled values with comma formatting.</p>
                                <div class="mt-3 rounded bg-white px-2 py-1 text-xs font-mono font-bold text-gray-800 border border-gray-100 dark:bg-gray-900 dark:border-gray-700 dark:text-gray-200" x-text="sampleValue('absolute')">
                                    ₹ 1,00,000
                                </div>
                            </div>

                            <!-- In Thousands -->
                            <div role="button" tabindex="0"
                                 x-on:keydown.enter.prevent="setFormat('thousands')"
                                 x-on:keydown.space.prevent="setFormat('thousands')"
                                 x-on:click="setFormat('thousands')"
                                 x-bind:class="preferences.financialFormat === 'thousands' ? 'border-brand-primary-blue bg-blue-50/50 ring-2 ring-brand-primary-blue/20 dark:bg-blue-900/20 dark:border-blue-500' : 'border-gray-200 hover:border-gray-300 dark:border-gray-700'"
                                 class="cursor-pointer rounded-xl border p-4 transition-all">
                                <div class="flex items-center justify-between">
                                    <span class="text-sm font-bold text-gray-900 dark:text-white">In Thousands</span>
                                    <input type="radio" value="thousands" x-model="preferences.financialFormat" x-on:change="savePreferences(false)" class="text-brand-primary-blue" />
                                </div>
                                <p class="mt-1 text-[11px] text-gray-500 dark:text-gray-400">Scaled in '000s (K) for compact presentation.</p>
                                <div class="mt-3 rounded bg-white px-2 py-1 text-xs font-mono font-bold text-gray-800 border border-gray-100 dark:bg-gray-900 dark:border-gray-700 dark:text-gray-200" x-text="sampleValue('thousands')">
                                    ₹ 100.00 K
                                </div>
                            </div>

                            <!-- In Lakhs -->
                            <div role="button" tabindex="0"
                                 x-on:keydown.enter.prevent="setFormat('lakhs')"
                                 x-on:keydown.space.prevent="setFormat('lakhs')"
                                 x-on:click="setFormat('lakhs')"
                                 x-bind:class="preferences.financialFormat === 'lakhs' ? 'border-brand-primary-blue bg-blue-50/50 ring-2 ring-brand-primary-blue/20 dark:bg-blue-900/20 dark:border-blue-500' : 'border-gray-200 hover:border-gray-300 dark:border-gray-700'"
                                 class="cursor-pointer rounded-xl border p-4 transition-all">
                                <div class="flex items-center justify-between">
                                    <span class="text-sm font-bold text-gray-900 dark:text-white">In Lakhs (L)</span>
                                    <input type="radio" value="lakhs" x-model="preferences.financialFormat" x-on:change="savePreferences(false)" class="text-brand-primary-blue" />
                                </div>
                                <p class="mt-1 text-[11px] text-gray-500 dark:text-gray-400">Standard Indian corporate filings scale (Recommended).</p>
                                <div class="mt-3 rounded bg-white px-2 py-1 text-xs font-mono font-bold text-gray-800 border border-gray-100 dark:bg-gray-900 dark:border-gray-700 dark:text-gray-200" x-text="sampleValue('lakhs')">
                                    ₹ 1.00 L
                                </div>
                            </div>

                            <!-- In Crores -->
                            <div role="button" tabindex="0"
                                 x-on:keydown.enter.prevent="setFormat('crores')"
                                 x-on:keydown.space.prevent="setFormat('crores')"
                                 x-on:click="setFormat('crores')"
                                 x-bind:class="preferences.financialFormat === 'crores' ? 'border-brand-primary-blue bg-blue-50/50 ring-2 ring-brand-primary-blue/20 dark:bg-blue-900/20 dark:border-blue-500' : 'border-gray-200 hover:border-gray-300 dark:border-gray-700'"
                                 class="cursor-pointer rounded-xl border p-4 transition-all">
                                <div class="flex items-center justify-between">
                                    <span class="text-sm font-bold text-gray-900 dark:text-white">In Crores (Cr)</span>
                                    <input type="radio" value="crores" x-model="preferences.financialFormat" x-on:change="savePreferences(false)" class="text-brand-primary-blue" />
                                </div>
                                <p class="mt-1 text-[11px] text-gray-500 dark:text-gray-400">Institutional / macro reporting scale in 10 Million units.</p>
                                <div class="mt-3 rounded bg-white px-2 py-1 text-xs font-mono font-bold text-gray-800 border border-gray-100 dark:bg-gray-900 dark:border-gray-700 dark:text-gray-200" x-text="sampleValue('crores')">
                                    ₹ 0.01 Cr
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Preference Card 3: Currency Conversion Rate -->
                    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs dark:border-gray-800 dark:bg-gray-800">
                        <div class="flex items-center justify-between border-b border-gray-100 pb-4 dark:border-gray-700">
                            <div class="flex items-center gap-3">
                                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-brand-primary-blue font-bold text-xs dark:bg-blue-900/40 dark:text-blue-300">
                                    3
                                </span>
                                <div>
                                    <h3 class="text-base font-bold text-gray-900 dark:text-white">
                                        Exchange Rate (USD to INR Conversion)
                                    </h3>
                                    <p class="text-xs text-gray-500 dark:text-gray-400">
                                        Specify the conversion rate used to convert USD values to INR or vice versa.
                                    </p>
                                </div>
                            </div>
                            <span class="text-xs font-mono font-bold text-gray-700 dark:text-gray-300" x-text="`1 USD = ${preferences.exchangeRate} INR`"></span>
                        </div>

                        <div class="mt-5 space-y-4">
                            <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                                <label class="text-xs font-semibold text-gray-700 dark:text-gray-300 shrink-0">
                                    1 USD =
                                </label>
                                <div class="relative w-full max-w-xs">
                                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-xs font-bold text-gray-400">
                                        ₹
                                    </span>
                                    <input type="number" step="0.000001" min="1" max="100000" x-model.number="preferences.exchangeRate" x-on:input="savePreferences(false)"
                                           class="w-full rounded-xl border border-gray-300 pl-8 pr-14 py-2.5 text-sm font-mono font-bold text-gray-900 shadow-xs focus:border-brand-primary-blue focus:ring-1 focus:ring-brand-primary-blue dark:border-gray-700 dark:bg-gray-900 dark:text-white"
                                           placeholder="83.50" />
                                    <span class="absolute inset-y-0 right-0 flex items-center pr-3 text-xs font-semibold text-gray-400">
                                        INR
                                    </span>
                                </div>
                                <span class="text-xs text-gray-500 dark:text-gray-400">
                                    (Used for currency calculations in the report)
                                </span>
                            </div>

                            <!-- Quick Presets -->
                            <div class="flex items-center gap-2 pt-1">
                                <span class="text-xs text-gray-500 dark:text-gray-400">Common Presets:</span>
                                <button type="button" x-on:click="setPresetRate(83.00)" class="rounded-lg bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-300">83.00</button>
                                <button type="button" x-on:click="setPresetRate(83.50)" class="rounded-lg bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-300">83.50 (Sample default)</button>
                                <button type="button" x-on:click="setPresetRate(84.00)" class="rounded-lg bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-300">84.00</button>
                                <button type="button" x-on:click="setPresetRate(84.50)" class="rounded-lg bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-300">84.50</button>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Right Col: Live Preview & Action Sidebar -->
                <div class="col-span-12 xl:col-span-4 space-y-6">

                    <!-- Live Preview Card -->
                    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs dark:border-gray-800 dark:bg-gray-800">
                        <div class="flex items-center justify-between border-b border-gray-100 pb-3 dark:border-gray-700">
                            <h4 class="text-sm font-bold text-gray-900 dark:text-white flex items-center gap-2">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-brand-primary-blue">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                Live Numbers Preview
                            </h4>
                            <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300">
                                Real-time
                            </span>
                        </div>

                        <div class="mt-4 space-y-3 text-xs">
                            <div class="rounded-xl bg-gray-50 p-3.5 dark:bg-gray-900 border border-gray-100 dark:border-gray-700">
                                <span class="text-[11px] font-semibold text-gray-500 dark:text-gray-400">Sample Company</span>
                                <h5 class="text-xs font-bold text-gray-900 dark:text-white mt-0.5">ZAUBA TECHNOLOGIES PRIVATE LIMITED</h5>
                                <span class="text-[10px] font-mono text-gray-500">CIN: U72300KA2012PTC066088</span>
                            </div>

                            <div class="space-y-2 pt-1">
                                <div class="flex items-center justify-between py-1.5 border-b border-gray-100 dark:border-gray-700">
                                    <span class="text-gray-600 dark:text-gray-400">Authorised Capital:</span>
                                    <span class="font-mono font-bold text-brand-primary-blue text-sm dark:text-blue-400" x-text="formatValue(200000)"></span>
                                </div>
                                <div class="flex items-center justify-between py-1.5 border-b border-gray-100 dark:border-gray-700">
                                    <span class="text-gray-600 dark:text-gray-400">Paid Up Capital:</span>
                                    <span class="font-mono font-bold text-emerald-600 text-sm dark:text-emerald-400" x-text="formatValue(100000)"></span>
                                </div>
                                <div class="flex items-center justify-between py-1.5">
                                    <span class="text-gray-600 dark:text-gray-400">Paidup / Auth Ratio:</span>
                                    <span class="font-mono font-bold text-gray-900 dark:text-white">50.0%</span>
                                </div>
                            </div>

                            <!-- Active Formula Note -->
                            <div class="mt-3 rounded-lg bg-blue-50/60 p-3 text-[11px] text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 space-y-1">
                                <div class="font-bold">Active Configuration:</div>
                                <div>• Currency: <strong x-text="preferences.currency"></strong></div>
                                <div>• Scale: <strong class="capitalize" x-text="preferences.financialFormat"></strong></div>
                                <div x-show="preferences.currency === 'USD'">• Rate: <strong>1 USD = <span x-text="preferences.exchangeRate"></span> INR</strong></div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Controls -->
                    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs dark:border-gray-800 dark:bg-gray-800 space-y-3">
                        <button type="button" x-on:click="proceedToSelect()"
                                class="w-full flex items-center justify-center gap-2 rounded-xl bg-brand-primary-blue px-5 py-3 text-sm font-semibold text-white shadow-md hover:bg-brand-primary-blue/90 transition-all">
                            <span>Save & Select Peers</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </button>

                        <button type="button" x-on:click="savePreferences(true)"
                                class="w-full flex items-center justify-center gap-2 rounded-xl border border-gray-300 bg-white px-4 py-2.5 text-xs font-semibold text-gray-700 shadow-2xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 transition-colors">
                            Save Preferences Only
                        </button>

                        <button type="button" x-on:click="resetDefaults()"
                                class="w-full text-center text-xs text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 pt-1 transition-colors">
                            Reset to Sample Defaults
                        </button>
                    </div>

                </div>

            </div>

        </div>
    </fieldset>
</section>
@section Scripts {
    <script src="~/js/reportsettings/reportsettings.js" asp-append-version="true"></script>
}
