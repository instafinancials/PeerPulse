@model PeerPulse.Web.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Login";
    ViewData["Description"] = "Login to PeerPulse.";
}

@section Head {
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
}

<main class="login-page">
    <section class="login-hero">
        <div class="login-hero__content">
            <img src="https://www.instafinancials.com/img/aboutus/InstaFinancials-Logo-white.svg"
                 alt="InstaFinancials"
                 class="login-hero__logo" />

            <span class="login-hero__eyebrow">PEERPULSE BY INSTAFINANCIALS</span>

            <h1>Know your competitors better.</h1>

            <p>
                Discover competitor intelligence, verified business data,
                and market signals in one unified workspace.
            </p>

            <ul class="login-hero__benefits">
                <li><i class="bi bi-check2"></i> Verified company registry information</li>
                <li><i class="bi bi-check2"></i> Competitor and industry intelligence</li>
                <li><i class="bi bi-check2"></i> Strategic business benchmarking</li>
            </ul>
        </div>
    </section>

    <section class="login-panel">
        <div class="login-card">
            <div class="login-card__top">
                <img src="~/images/logo/logo.svg"
                     alt="InstaFinancials"
                     class="login-card__logo" />

                <p>
                    New user?
                    <a href="https://www.instafinancials.com/accounts/Signup.aspx"
                       target="_blank"
                       rel="noopener noreferrer">
                        Sign up
                    </a>
                </p>
            </div>

            <div class="login-card__title">
                <span>WELCOME BACK</span>
                <h1>Login to PeerPulse</h1>
                <p>Enter your details to continue.</p>
            </div>

            @* GoogleLogin action must be configured in AccountController. *@
            <form asp-controller="Account" asp-action="GoogleLogin" method="post">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                <button type="submit" class="google-button">
                    <img class="google-button__icon"
                         src="~/images/logo/google-color.svg"
                         alt=""
                         aria-hidden="true" />

                    <span>Continue with Google</span>
                </button>
            </form>

            <div class="login-divider">
                <span></span>
                <small>OR CONTINUE WITH</small>
                <span></span>
            </div>

            <div class="login-tabs" role="tablist" aria-label="Login method">
                <button type="button"
                        id="emailTab"
                        class="login-tabs__button is-active"
                        onclick="setLoginMode('email')">
                    <i class="bi bi-envelope"></i>
                    Email
                </button>

                <button type="button"
                        id="mobileTab"
                        class="login-tabs__button"
                        onclick="setLoginMode('mobile')">
                    <i class="bi bi-phone"></i>
                    Mobile
                </button>
            </div>

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post"
                  novalidate>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="login-field">
                    <div class="login-field__label-row">
                        <label id="identifierLabel" asp-for="Identifier">
                            Email address
                        </label>

                        <a id="forgotIdentifierLink"
                           href="https://www.instafinancials.com/accounts/ForgotEmail.aspx"
                           target="_blank"
                           rel="noopener noreferrer">
                            Forgot email?
                        </a>
                    </div>

                    <div class="login-input">
                        <i id="identifierIcon" class="bi bi-envelope"></i>

                        <input asp-for="Identifier"
                               id="loginIdentifier"
                               type="email"
                               autocomplete="username"
                               placeholder="name@example.com"
                               maxlength="254"
                               autofocus />
                    </div>
                </div>

                <div class="login-field">
                    <div class="login-field__label-row">
                        <label asp-for="Password">Password</label>

                        <a class="login-field__forgot-password"
                           href="https://www.instafinancials.com/accounts/ForgotPassword.aspx"
                           target="_blank"
                           rel="noopener noreferrer">
                            Forgot password?
                        </a>
                    </div>

                    <div class="login-input login-input--password">
                        <i class="bi bi-lock"></i>

                        <input asp-for="Password"
                               id="loginPassword"
                               type="password"
                               autocomplete="current-password"
                               placeholder="Enter your password" />

                        <button type="button"
                                id="passwordToggle"
                                aria-label="Show password"
                                onclick="toggleLoginPassword()">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="login-actions">
                    <label class="login-remember">
                        <input asp-for="RememberMe" />
                        <span>Keep me signed in</span>
                    </label>

                    <button type="submit" class="login-submit">
                        Login <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </form>

            <p class="login-security">
                <i class="bi bi-shield-check"></i>
                Your login is protected with secure authentication.
            </p>
        </div>
    </section>
</main>

@* One popup for every AccountController SetPopup(...) result. *@
@if (ViewData["PopupTitle"] is string popupTitle)
{
    @await Component.InvokeAsync("ModelPopup", new
    {
        id = "loginPopup",
        theme = ViewData["PopupTheme"]?.ToString() ?? "warning",
        title = popupTitle,
        message = ViewData["PopupMessage"]?.ToString() ?? "Please try again.",
        primaryText = ViewData["PopupPrimaryText"]?.ToString() ?? "Close",
        primaryUrl = ViewData["PopupPrimaryUrl"]?.ToString(),
        secondaryText = ViewData["PopupSecondaryText"]?.ToString()
    })

    <script>
        window.addEventListener("DOMContentLoaded", function() {
            document.getElementById("loginPopup")?.showModal();
        });
    </script>
}

@section Scripts {
    <script>
        function toggleLoginPassword() {
            const password = document.getElementById("loginPassword");
            const button = document.getElementById("passwordToggle");
            const icon = button.querySelector("i");

            const isVisible = password.type === "text";

            password.type = isVisible ? "password" : "text";
            icon.className = isVisible ? "bi bi-eye" : "bi bi-eye-slash";

            button.setAttribute(
                "aria-label",
                isVisible ? "Show password" : "Hide password");
        }

        function setLoginMode(mode) {
            const isMobile = mode === "mobile";

            const emailTab = document.getElementById("emailTab");
            const mobileTab = document.getElementById("mobileTab");
            const input = document.getElementById("loginIdentifier");
            const label = document.getElementById("identifierLabel");
            const icon = document.getElementById("identifierIcon");
            const forgotLink = document.getElementById("forgotIdentifierLink");

            emailTab.classList.toggle("is-active", !isMobile);
            mobileTab.classList.toggle("is-active", isMobile);

            input.value = "";
            input.type = isMobile ? "tel" : "email";
            input.inputMode = isMobile ? "numeric" : "email";
            input.maxLength = isMobile ? 10 : 254;
            input.placeholder = isMobile
                ? "Enter 10-digit mobile number"
                : "name@example.com";

            label.textContent = isMobile
                ? "Mobile number"
                : "Email address";

            icon.className = isMobile
                ? "bi bi-phone"
                : "bi bi-envelope";

            forgotLink.textContent = isMobile
                ? "Forgot mobile?"
                : "Forgot email?";

            forgotLink.href = isMobile
                ? "https://www.instafinancials.com/accounts/ForgotPassword.aspx"
                : "https://www.instafinancials.com/accounts/ForgotEmail.aspx";
        }
    </script>
}