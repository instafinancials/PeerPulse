@model StaticComparisonViewModel
<details id="section-websocial" class="mb-14 scroll-mt-24 report-native-section" open="open">

            
    <summary class="mb-6 rounded-2xl bg-gradient-to-r from-cyan-500/10 via-teal-50/50 to-blue-50/40 p-5 border border-cyan-500/20 dark:from-cyan-950/40 dark:via-gray-800 dark:to-gray-800 dark:border-cyan-900/40 report-native-heading">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-center gap-3.5">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-cyan-600 text-white shadow-sm shadow-cyan-500/30">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z">
                        </path>
                    </svg>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="rounded bg-cyan-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-cyan-800 dark:bg-cyan-900/40 dark:text-cyan-300">
                            Digital Footprint
                        </span>
                        <span class="text-xs text-gray-500 font-mono">@($"{Model.selectedPeers.Count} Companies Compared")</span>
                    </div>
                    <h2 class="text-lg font-extrabold text-gray-900 dark:text-white mt-0.5">
                        Section 2: Web &amp; Social Links
                    </h2>
                    <p class="text-xs text-gray-600 dark:text-gray-300">
                        Official company websites, website SEO titles &amp; descriptions, and verified social media channels.
                    </p>
                </div>
            </div>

                
            <span class="inline-flex items-center gap-1.5 rounded-xl border border-gray-200 bg-white px-3.5 py-2 text-xs font-bold text-gray-700 shadow-2xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700 transition-colors">
                <span><span class="report-expand-label">Expand Web &amp; Social Links</span><span class="report-collapse-label">Collapse Web &amp; Social Links</span></span>
                <svg class="h-4 w-4 transition-transform duration-200 report-toggle-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="18 15 12 9 6 15"></polyline>
                </svg>
            </span>
        </div>
    </summary>

            
    <div class="space-y-8">

              
        <div id="subsection-web-overview" class="space-y-4">
            <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden dark:border-gray-800 dark:bg-gray-800">
                <div class="bg-gray-50 px-4 py-3.5 border-b border-gray-200 dark:bg-gray-900/80 dark:border-gray-700 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="flex h-6 w-6 items-center justify-center rounded-md bg-cyan-100 text-cyan-800 font-bold text-xs dark:bg-cyan-950 dark:text-cyan-300">2.1</span>
                        <h4 class="text-xs font-bold uppercase tracking-wider text-gray-800 dark:text-gray-100">
                            Digital Footprint &amp; Web Overview
                        </h4>
                    </div>
                    <span class="rounded-full bg-cyan-50 border border-cyan-200 px-2.5 py-0.5 text-[11px] font-semibold text-cyan-800 dark:border-cyan-800 dark:bg-cyan-950/60 dark:text-cyan-300">
                        Verified Online Assets
                    </span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
                @foreach (var p in Model.selectedPeers)
                {

                    <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-xs flex flex-col justify-between dark:border-gray-800 dark:bg-gray-800 hover:shadow-md transition-shadow">
                        <div>

                            <div class="flex items-start justify-between gap-3 pb-3 border-b border-gray-100 dark:border-gray-700">
                                <div class="flex-1 min-w-0">
                                    <h4 class="font-bold text-sm text-gray-900 dark:text-white truncate">@(p.company)</h4>
                                    <span class="text-[11px] font-mono text-gray-400 block">@(p.cin)</span>
                                </div>
                                <span class="shrink-0 flex h-8 w-8 items-center justify-center rounded-lg bg-cyan-50 text-cyan-600 dark:bg-cyan-950 dark:text-cyan-400">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="2" y1="12" x2="22" y2="12"></line>
                                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z">
                                        </path>
                                    </svg>
                                </span>
                            </div>

                        
                            <div class="py-3">
                                <div class="text-[11px] uppercase font-semibold text-gray-400 tracking-wider mb-1">
                                    Official
                                    Website
                                </div>
                                @if (StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).website))
                                {

                                    <a href="@(StaticComparisonViewModel.SafeUrl(Model.getWebSocialMedia(p).website))" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-primary-blue hover:underline dark:text-blue-400 break-all">
                                        <span>@(StaticComparisonViewModel.DisplayHost(Model.getWebSocialMedia(p).website))</span>
                                        <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                            <polyline points="15 3 21 3 21 9"></polyline>
                                            <line x1="10" y1="14" x2="21" y2="3"></line>
                                        </svg>
                                    </a>

                                }

                                @if (!(StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).website)))
                                {

                                    <span class="text-xs text-gray-400 italic">No website specified</span>

                                }

                            </div>

                        
                            @if ((StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).title) || StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).description)))
                            {

                                <div class="py-2.5 px-3 rounded-xl bg-gray-50 dark:bg-gray-900/60 border border-gray-100 dark:border-gray-700/60 mb-3 space-y-1.5">
                                    @if (StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).title))
                                    {

                                        <p class="text-xs font-bold text-gray-800 dark:text-gray-200 line-clamp-2">@(Model.getWebSocialMedia(p).title)</p>

                                    }

                                    @if (StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).description))
                                    {

                                        <p class="text-[11px] text-gray-600 dark:text-gray-400 leading-relaxed line-clamp-3">@(Model.getWebSocialMedia(p).description)</p>

                                    }

                                </div>

                            }

                        </div>

                      
                        <div class="pt-3 border-t border-gray-100 dark:border-gray-700 mt-2">
                            <div class="text-[11px] uppercase font-semibold text-gray-400 tracking-wider mb-2">
                                Social
                                Channels
                            </div>
                            <div class="flex items-center gap-2 flex-wrap">

                          
                                @if (StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).linkedin))
                                {

                                    <a href="@(StaticComparisonViewModel.SafeUrl(Model.getWebSocialMedia(p).linkedin))" target="_blank" rel="noopener noreferrer" title="LinkedIn Profile" class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-[#0A66C2] hover:bg-[#0A66C2] hover:text-white transition-colors dark:bg-blue-950/60 dark:text-blue-300 dark:hover:bg-[#0A66C2] dark:hover:text-white border border-blue-200 dark:border-blue-900">
                                        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                                            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.63 1.63 0 1 0 1.63 1.63 1.63 1.63 0 0 0-1.63-1.63z"></path>
                                        </svg>
                                    </a>

                                }


                          
                                @if (StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).facebook))
                                {

                                    <a href="@(StaticComparisonViewModel.SafeUrl(Model.getWebSocialMedia(p).facebook))" target="_blank" rel="noopener noreferrer" title="Facebook Page" class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-[#1877F2] hover:bg-[#1877F2] hover:text-white transition-colors dark:bg-blue-950/60 dark:text-blue-300 dark:hover:bg-[#1877F2] dark:hover:text-white border border-blue-200 dark:border-blue-900">
                                        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
                                        </svg>
                                    </a>

                                }


                          
                                @if (StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).twitter))
                                {

                                    <a href="@(StaticComparisonViewModel.SafeUrl(Model.getWebSocialMedia(p).twitter))" target="_blank" rel="noopener noreferrer" title="Twitter / X" class="flex h-8 w-8 items-center justify-center rounded-lg bg-gray-100 text-gray-800 hover:bg-black hover:text-white transition-colors dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-black dark:hover:text-white border border-gray-300 dark:border-gray-600">
                                        <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
                                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                                        </svg>
                                    </a>

                                }


                          
                                @if (StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).instagram))
                                {

                                    <a href="@(StaticComparisonViewModel.SafeUrl(Model.getWebSocialMedia(p).instagram))" target="_blank" rel="noopener noreferrer" title="Instagram" class="flex h-8 w-8 items-center justify-center rounded-lg bg-pink-50 text-[#E4405F] hover:bg-[#E4405F] hover:text-white transition-colors dark:bg-pink-950/60 dark:text-pink-300 dark:hover:bg-[#E4405F] dark:hover:text-white border border-pink-200 dark:border-pink-900">
                                        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
                                        </svg>
                                    </a>

                                }


                          
                                @if (StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).youtube))
                                {

                                    <a href="@(StaticComparisonViewModel.SafeUrl(Model.getWebSocialMedia(p).youtube))" target="_blank" rel="noopener noreferrer" title="YouTube Channel" class="flex h-8 w-8 items-center justify-center rounded-lg bg-red-50 text-[#FF0000] hover:bg-[#FF0000] hover:text-white transition-colors dark:bg-red-950/60 dark:text-red-300 dark:hover:bg-[#FF0000] dark:hover:text-white border border-red-200 dark:border-red-900">
                                        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                                            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
                                        </svg>
                                    </a>

                                }


                          
                                @if ((!(StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).linkedin)) && !(StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).facebook)) && !(StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).twitter)) && !(StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).instagram)) && !(StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).youtube))))
                                {

                                    <span class="text-xs text-gray-400 italic">No social media profiles added</span>

                                }

                            </div>
                        </div>
                    </div>

                }

            </div>
        </div>

              
        <div id="subsection-web-table" class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden dark:border-gray-800 dark:bg-gray-800">
            <div class="bg-gray-50 px-4 py-3.5 border-b border-gray-200 dark:bg-gray-900/80 dark:border-gray-700 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="flex h-6 w-6 items-center justify-center rounded-md bg-cyan-100 text-cyan-800 font-bold text-xs dark:bg-cyan-950 dark:text-cyan-300">2.2</span>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-gray-800 dark:text-gray-100">
                        Comparative Web &amp; Social Media Matrix
                    </h4>
                </div>
                <span class="rounded-full bg-cyan-50 border border-cyan-200 px-2.5 py-0.5 text-[11px] font-semibold text-cyan-800 dark:border-cyan-800 dark:bg-cyan-950/60 dark:text-cyan-300">
                    Online Presence Comparison
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-gray-50/80 border-b border-gray-200 dark:bg-gray-900/50 dark:border-gray-700">
                        <tr>
                            <th class="py-3 px-4 w-60 text-[11px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 sticky left-0 bg-gray-50/95 dark:bg-gray-900/95 z-10">
                                Digital Channel / Parameter
                            </th>
                            @foreach (var p in Model.selectedPeers)
                            {

                                <th class="py-3 px-4 min-w-[260px] border-l border-gray-100 dark:border-gray-700">
                                    <span class="font-bold text-gray-900 dark:text-white">@(p.company)</span>
                                </th>

                            }

                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">

                      
                        <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-800/50">
                            <td class="py-3.5 px-4 font-bold text-gray-800 dark:text-gray-200 sticky left-0 bg-white dark:bg-gray-800 z-10">
                                Official Website
                            </td>
                            @foreach (var p in Model.selectedPeers)
                            {

                                <td class="py-3.5 px-4 border-l border-gray-100 dark:border-gray-700 font-medium">
                                    @if (StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).website))
                                    {

                                        <a href="@(StaticComparisonViewModel.SafeUrl(Model.getWebSocialMedia(p).website))" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-brand-primary-blue hover:underline dark:text-blue-400 font-semibold break-all">
                                            <span>@(StaticComparisonViewModel.DisplayHost(Model.getWebSocialMedia(p).website))</span>
                                            <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                                <polyline points="15 3 21 3 21 9"></polyline>
                                                <line x1="10" y1="14" x2="21" y2="3"></line>
                                            </svg>
                                        </a>

                                    }

                                    @if (!(StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).website)))
                                    {

                                        <span class="text-gray-300 dark:text-gray-600">-</span>

                                    }

                                </td>

                            }

                        </tr>

                      
                        <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-800/50">
                            <td class="py-3.5 px-4 font-bold text-gray-800 dark:text-gray-200 sticky left-0 bg-white dark:bg-gray-800 z-10">
                                Website Title (SEO)
                            </td>
                            @foreach (var p in Model.selectedPeers)
                            {

                                <td class="py-3.5 px-4 border-l border-gray-100 dark:border-gray-700 text-gray-700 dark:text-gray-300 text-xs leading-relaxed">@(StaticComparisonViewModel.Or(Model.getWebSocialMedia(p).title, "-"))</td>

                            }

                        </tr>

                      
                        <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-800/50">
                            <td class="py-3.5 px-4 font-bold text-gray-800 dark:text-gray-200 sticky left-0 bg-white dark:bg-gray-800 z-10">
                                Website Description
                            </td>
                            @foreach (var p in Model.selectedPeers)
                            {

                                <td class="py-3.5 px-4 border-l border-gray-100 dark:border-gray-700 text-gray-600 dark:text-gray-400 text-[11px] leading-relaxed">@(StaticComparisonViewModel.Or(Model.getWebSocialMedia(p).description, "-"))</td>

                            }

                        </tr>

                      
                        <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-800/50">
                            <td class="py-3 px-4 font-bold text-gray-800 dark:text-gray-200 sticky left-0 bg-white dark:bg-gray-800 z-10">
                                <span class="flex items-center gap-1.5">
                                    <span class="h-2 w-2 rounded-full bg-[#0A66C2]"></span>
                                    LinkedIn
                                </span>
                            </td>
                            @foreach (var p in Model.selectedPeers)
                            {

                                <td class="py-3 px-4 border-l border-gray-100 dark:border-gray-700">
                                    @if (StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).linkedin))
                                    {

                                        <a href="@(StaticComparisonViewModel.SafeUrl(Model.getWebSocialMedia(p).linkedin))" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[#0A66C2] hover:underline font-mono text-xs">
                                            <span>View Profile</span>
                                            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                                <polyline points="15 3 21 3 21 9"></polyline>
                                                <line x1="10" y1="14" x2="21" y2="3"></line>
                                            </svg>
                                        </a>

                                    }

                                    @if (!(StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).linkedin)))
                                    {

                                        <span class="text-gray-300 dark:text-gray-600">-</span>

                                    }

                                </td>

                            }

                        </tr>

                      
                        <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-800/50">
                            <td class="py-3 px-4 font-bold text-gray-800 dark:text-gray-200 sticky left-0 bg-white dark:bg-gray-800 z-10">
                                <span class="flex items-center gap-1.5">
                                    <span class="h-2 w-2 rounded-full bg-[#1877F2]"></span>
                                    Facebook
                                </span>
                            </td>
                            @foreach (var p in Model.selectedPeers)
                            {

                                <td class="py-3 px-4 border-l border-gray-100 dark:border-gray-700">
                                    @if (StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).facebook))
                                    {

                                        <a href="@(StaticComparisonViewModel.SafeUrl(Model.getWebSocialMedia(p).facebook))" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[#1877F2] hover:underline font-mono text-xs">
                                            <span>View Page</span>
                                            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                                <polyline points="15 3 21 3 21 9"></polyline>
                                                <line x1="10" y1="14" x2="21" y2="3"></line>
                                            </svg>
                                        </a>

                                    }

                                    @if (!(StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).facebook)))
                                    {

                                        <span class="text-gray-300 dark:text-gray-600">-</span>

                                    }

                                </td>

                            }

                        </tr>

                      
                        <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-800/50">
                            <td class="py-3 px-4 font-bold text-gray-800 dark:text-gray-200 sticky left-0 bg-white dark:bg-gray-800 z-10">
                                <span class="flex items-center gap-1.5">
                                    <span class="h-2 w-2 rounded-full bg-black dark:bg-white"></span>
                                    Twitter / X
                                </span>
                            </td>
                            @foreach (var p in Model.selectedPeers)
                            {

                                <td class="py-3 px-4 border-l border-gray-100 dark:border-gray-700">
                                    @if (StaticComparisonViewModel.Truthy(Model.getWebSocialMedia(p).twitter))
                                    {

